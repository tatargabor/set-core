{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-relay-supersede",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-leakscan",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "set-hook-checkout-guard PreToolUse"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-question-relay",
            "timeout": 3600
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-core SET_AGENT_ROOM=wpc-board \"$S\" hook watch-guard || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-notify-relay",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-checkout-guard PostToolUse"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-core SET_AGENT_ROOM=wpc-board \"$S\" hook heartbeat || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-arm.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-waveboard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "set-hook-wait-detect",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "set-hook-continue-relay",
            "timeout": 3700,
            "asyncRewake": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; [ -x \"$S\" ] && SET_AGENT_NAME=set-core SET_AGENT_ROOM=wpc-board \"$S\" hook stop || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-permission-relay",
            "timeout": 3700
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(command -v sac || echo \"$HOME/.local/bin/sac\")\"; if [ -x \"$S\" ]; then SET_AGENT_NAME=set-core SET_AGENT_ROOM=wpc-board \"$S\" hook session-start; else echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"[set-agent-comm] ⚠ `sac` is not installed on this machine (not on PATH, not in ~/.local/bin), so this project is OFF the bus here: no wake-ups, no unread-mail check, no heartbeat. Fix: run `bin/sac.mjs setup` from a set-agent-comm checkout on this machine, then restart the session.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-reinject-clear.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
