[Unit]
Description=SET Web Dashboard
Documentation=https://github.com/tatargabor/set-core
After=default.target

[Service]
ExecStart=%h/.local/bin/set-orch-core serve --port 7400
Restart=always
RestartSec=5
Environment=PYTHONPATH=__SET_TOOLS_ROOT__/lib:__SET_TOOLS_ROOT__/modules/web
# Filled in by the installer from the installing shell (where claude, node, pnpm,
# npx and uv live on THIS machine) — a fixed list only fits the machine it was written on.
Environment=PATH=__SERVICE_PATH__

[Install]
WantedBy=default.target
