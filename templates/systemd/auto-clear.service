[Unit]
# Auto-clear executor for @TREE@ (set-claude-handoff), written by `set-project init`
# (auto-clear-default-install). The gate only evaluates; this watcher is the only thing that
# types /clear and the auto-continue prompt. Kill switch: touch .set/handoff/.no-autoclear in
# the tree. Opt the project out with `auto_clear: false` in its registry entry.
#
# No threshold or background flag: the package defaults apply, so a package upgrade moves
# them. No --started-after either: since the package's be300a2 the start filter is opt-in,
# because a running session picks up a reload hook added mid-run (measured on Claude Code
# 2.1.331), so the filter only excluded sessions that could reload.
#
# PYTHONPATH carries set-core's lib: the watcher looks fleet-hosted sessions up through
# set_orch.fleet.owner_client, and without it every such session reads "no writer path" and is
# never nudged or cleared (measured 2026-11-24: 36 of 41 units lacked it).
#
# init never rewrites this file once it exists; edit it by hand if you need to.
Description=@NAME@ auto-clear watcher
After=default.target

[Service]
Environment=PATH=%h/.local/bin:@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=@SET_CORE_LIB@
ExecStart=/bin/bash @TREE@/.claude/hooks/watch-auto-clear.sh --dir @TREE@ --interval 60 --auto-continue default
Restart=on-failure

[Install]
WantedBy=default.target
