#!/usr/bin/env python3
"""set-hook-continue-relay — Claude Code Stop hook, run with `asyncRewake: true` (B-190).

While this machine's question relay is on with a two-way (`command`) outbound, a turn the
wait detector classified DONE is posted as a continuation question: a short summary, up
to three suggested next steps, and free text. An answer wakes the idle session with it.
The hook runs in the background beside the idle prompt, so the terminal is never held.
The decision lives in `set_orch.fleet.continuation`; this file is the carrier.

THE EXIT CODE IS THE CONTRACT: 0 = nothing happens; 2 = the runtime wakes the session
with stderr as the instruction (measured on 2.1.330). Every failure exits 0.

Logs go to the relay's log file and carry no summary, suggestion, or answer text.
Referenced by name from .claude/settings.json; on PATH through install.sh.
"""
from __future__ import annotations

import json
import logging
import os
import signal
import sys

_SET_TOOLS_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_LIB = os.path.join(_SET_TOOLS_ROOT, "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)


def _exit_cleanly(signum, _frame):
    # Measured 2026-11-22: closing the session kills this hook mid-wait, and a default
    # signal death skips the library's `finally:` — the waiting record stays, and the
    # bridge (which reads the record files directly) keeps the channel post open. A
    # SystemExit unwinds through `finally:`, removes the record, and exits 0 (no wake).
    raise SystemExit(0)


def main() -> int:
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, _exit_cleanly)
    if os.environ.get("SET_WAIT_DETECT_CLASSIFIER"):
        return 0
    try:
        hook_input = json.load(sys.stdin)
    except ValueError:
        return 0
    if not isinstance(hook_input, dict):
        return 0
    try:
        from set_orch.fleet import continuation
        from set_orch.fleet import question_relay as qr

        if not qr.readiness()["enabled"]:
            return 0
        folder = qr.state_dir()
        folder.mkdir(parents=True, exist_ok=True)
        logging.basicConfig(filename=str(folder / "relay.log"), level=logging.INFO,
                            format="%(asctime)s %(levelname)s %(name)s: %(message)s")
        from set_orch.fleet import relay_backfill

        # B-250: a next step that reaches the hook's limit is carried on, not dropped.
        text = continuation.continue_turn(hook_input, on_timeout=relay_backfill.repull_continuation)
    except Exception as exc:  # a failed continuation leaves the session idle, as today
        logging.getLogger("set-hook-continue-relay").warning("continuation failed (%s)", type(exc).__name__)
        return 0
    if text:
        sys.stderr.write(text)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
