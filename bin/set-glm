#!/usr/bin/env python3
"""set-glm — Claude Code on the GLM provider, with the measured parameters.

The parameters are no longer computed here. They are DATA in
`~/.config/set-core/providers.json`, and this command resolves them through
`set_orch.providers` — the same resolver the fleet's agent owner uses. One
measured value, one place, two carriers. (Before this change the values lived in
this file AND in a consumer project's own implementation, written by one author
from one measurement; two copies of one measurement are not two measurements,
and they drift without either looking wrong.)

Usage — unchanged from the shell version this replaces:

    set-glm -p "prompt"                    one call
    set-glm -p "…" --output-format json    structured output
    set-glm                                an interactive session
    set-glm --check                        configuration plus a live probe
    set-glm --print-env                    the env that would be set (token MASKED)
    set-glm --model NAME                   a specific model from the catalogue

Everything not listed above is passed through to `claude` untouched.

**Why this is Python and not a shell wrapper.** The credential never becomes a
shell variable, never reaches stdout, and never appears in a process listing: it
is placed in the child's environment and the process is replaced. The shell
version had to `export` it, which is one `set -x` away from a transcript.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from set_orch.providers import is_secret_env_key, resolve  # noqa: E402
from set_orch.providers.config import load_or_legacy  # noqa: E402
from set_orch.providers.errors import ProviderError  # noqa: E402

PROVIDER = "glm"

DIM, RED, RESET = "\033[2m", "\033[31m", "\033[0m"


def note(message: str) -> None:
    print(f"{DIM}set-glm: {message}{RESET}", file=sys.stderr)


def die(message: str) -> None:
    print(f"{RED}set-glm: {message}{RESET}", file=sys.stderr)
    raise SystemExit(1)


def repo_root() -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        )
        return Path(out.stdout.strip())
    except Exception:
        return Path.cwd()


def removed_tier_hint() -> str:
    """Say that the OLD location is no longer read — not merely that nothing was found.

    Until this change, a `.env` in the repository could hold `GLM_*` keys and it
    was consulted. Removing that tier is the direct consequence of putting
    credentials in one machine-level place; a repository `.env` is git-tracked, so
    a worktree `reset --hard` takes it, and a careless `add` publishes it.

    The distinction this function exists for: an operator whose credential IS in
    that file and who is told "no credential configured" goes and creates a second
    one. They have to be told the place they used is no longer consulted.
    """
    env_file = repo_root() / ".env"
    if not env_file.exists():
        return ""
    try:
        has_glm = any(
            line.strip().startswith("GLM_") for line in env_file.read_text().splitlines()
        )
    except OSError:
        return ""
    if not has_glm:
        return ""
    return (
        f"\n\n⚠ {env_file} declares GLM_* keys and is NO LONGER READ. That tier was "
        "removed: a credential in a working tree is taken by a `reset --hard` and "
        "published by a careless `add`. Move it to the machine-level configuration "
        "with:  set-providers migrate   (or add it under providers.glm.credential)."
    )


def masked(token: str) -> str:
    return f"{token[:6]}…{token[-4:]} ({len(token)} chars)"


def main(argv):
    passthrough = [a for a in argv if a not in ("--check", "--print-env")]
    want_check = "--check" in argv
    want_env = "--print-env" in argv

    # The caller's own flags win. Reading them here rather than appending blindly
    # is what keeps `set-glm --model X` meaning what it says.
    requested_model = None
    if "--model" in passthrough:
        i = passthrough.index("--model")
        if i + 1 < len(passthrough):
            requested_model = passthrough[i + 1]

    try:
        cfg, notice = load_or_legacy()
        if notice:
            note(notice)
        plan = resolve(provider=PROVIDER, model=requested_model, config=cfg)
    except ProviderError as exc:
        die(f"{exc}{removed_tier_hint()}")
        return 1

    if want_env:
        for key in sorted(plan.env):
            value = plan.env[key]
            print(f"{key}={masked(value) if is_secret_env_key(key) else value}")
        print(f"# unset: {', '.join(plan.unset)}")
        print(f"# args:  {' '.join(plan.args)}")
        print(f"# {plan.describe()}")
        return 0

    child_env = dict(os.environ)
    for key in plan.unset:
        child_env.pop(key, None)
    child_env.update(plan.env)

    # The guard, at the point of the effect. A variable the resolver returned that
    # did not survive is not an error anywhere downstream — the measured
    # consequence is a compaction loop that reads from outside as a slow model.
    lost = [k for k, v in plan.env.items() if child_env.get(k) != v]
    if lost:
        die(f"the resolved environment did not survive: {', '.join(lost)}. Refusing to start.")

    args = list(passthrough)
    if "--autocompact" not in args and "--autocompact" in plan.args:
        args += list(plan.args)
    if "--model" not in args:
        args += ["--model", plan.model]

    if want_check:
        note(f"probe: {plan.describe()}")
        probe = subprocess.run(
            ["claude", *args, "-p", "Reply with ONE word: OK", "--output-format", "json"],
            env=child_env, capture_output=True, text=True,
        )
        sys.stdout.write(probe.stdout[:2000] + "\n")
        if probe.returncode != 0:
            sys.stderr.write(probe.stderr)
            die("the probe FAILED — the output above is the CLI's answer.")
        note("OK — the configuration is live.")
        return 0

    # ⚠ Not decoration: a frame switch has to be VISIBLE. Without this line the run
    # is indistinguishable from a plain `claude`, and the next reader — person or
    # agent — assigns its cost and its quality to the wrong frame.
    note(plan.describe())
    os.execvpe("claude", ["claude", *args], child_env)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
