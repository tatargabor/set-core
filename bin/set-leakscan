#!/usr/bin/env python3
"""set-leakscan — refuse to publish what must not leave the repository.

Usage:
    set-leakscan [--range <rev-range>] [--staged] [--tree] [--json] [--quiet]
    set-leakscan --message <file>     # scan a commit message (commit-msg hook)
    set-leakscan --install-hooks      # write pre-commit / commit-msg / pre-push
    set-leakscan --list-patterns      # show WHAT is searched for, not the values

Exit status: 0 = clean, 1 = findings, 2 = the scan itself could not run.

WHY THIS EXISTS
    set-core and its sibling `set-*` projects are public. The consumer projects
    they are developed against are not. A rule in prose cannot stop a push; this
    can. It is wired to a `pre-push` git hook and to a `PreToolUse` Claude hook,
    because a git hook does not bind an agent that sets `core.hooksPath`, and a
    Claude hook does not bind a human at a terminal. Since the env-marker
    category it also sits at COMMIT time through `pre-commit`/`commit-msg` and
    the same PreToolUse hook — a commit is the unit that accumulates, and by
    push time the only repair is a history rewrite.

THE NAME LISTS ARE NEVER STORED IN THE REPOSITORY
    Consumer names and this machine's identity (the local user's name tokens,
    git email, username, hostname) are exactly what must not be committed, so a
    checked-in pattern file would BE the leak — the same trap the project rules
    describe for `.gitignore`. Both lists are resolved at run time: consumer
    names from the local project registry (`~/.config/set-core/projects.json`),
    env-markers from the machine itself. Neither path is inside any repository.

THE ENV-MARKER CHECK MEASURES WHAT A DIFF ADDS
    A repository that follows the confidentiality rules still legitimately
    carries identity — clone URLs pointing at the author's own public account,
    doc examples that use the author's handle. A whole-file check would block
    every commit that touches those files and be removed within a week. The
    category is therefore evaluated against ADDED LINES only (staged added
    lines, new files in full, range added lines) and never in `--tree` mode.

IT REPORTS WHAT IT COULD NOT CHECK
    If the registry is unreadable the consumer-name check is SKIPPED, and that
    is stated loudly instead of being folded into a clean result. The same
    holds for an identity source that cannot be resolved. A scan that cannot
    see a category must not report zero for it: a gap is not a zero, and the
    failure direction of a silent skip is the expensive one.
"""

import argparse
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
REGISTRY = os.path.join(HOME, ".config", "set-core", "projects.json")
ALLOWLIST = os.path.join(HOME, ".config", "set-core", "leakscan-allow.txt")

# Slugs that are legitimately public: this project's own E2E fixtures and the
# public `set-*` family. They live in the registry beside the private ones, so
# without this the scan fires on every run and gets muted — a gate that cries
# daily on nothing is a gate nobody keeps.
BUILTIN_ALLOW = {
    "minishop", "craftbrew", "micro-web", "dungeon", "demo", "example",
    "test", "main", "app", "web", "shop", "site", "code", "docs",
}

SECRET_PATTERNS = [
    ("anthropic key",  r"sk-ant-[A-Za-z0-9_\-]{16,}"),
    ("openai key",     r"sk-[A-Za-z0-9]{32,}"),
    ("github token",   r"ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}"),
    ("aws key id",     r"AKIA[0-9A-Z]{16}"),
    ("slack token",    r"xox[baprs]-[A-Za-z0-9-]{10,}"),
    ("google api key", r"AIza[0-9A-Za-z_\-]{30,}"),
    ("private key",    r"-----BEGIN [A-Z ]*PRIVATE KEY"),
]

# `\+36…` style numbers are the local case; the shape generalises to any long
# run of digits that a human would recognise as a phone number.
PHONE_PATTERN = r"\+\d{1,3}[- ]?\d{2}[- ]?\d{3}[- ]?\d{4}\b|\"\+?\d{11,13}\""

# Identity tokens so generic that flagging them would cry daily on nothing:
# documentation and code legitimately teem with these words. The list guards
# the TOKEN side of the env-marker check only; a full email address or a
# hostname is never stoplisted.
MARKER_STOPLIST = {
    "user", "admin", "test", "main", "local", "home", "host", "dev",
    "git", "root", "info", "mail", "gmail", "example", "com", "org",
    "net", "name", "proj",
}

def home_path_pattern():
    """A path under THIS user's home — not any `/home/<something>/`.

    Two corrections, both measured on the first real run rather than guessed:

    * Anchored on a token boundary, because the unanchored form read the path
      segment of `https://www.atia.org/home/at-resources/` as a filesystem path.
    * Restricted to the actual local username, because a repository that follows
      the confidentiality rule is FULL of deliberately anonymised examples —
      `/home/someone/clients/...`, `/home/x/...`, `/home/linuxbrew/...`. Those
      are the rule succeeding, and flagging them is how a gate earns its way
      into `--no-verify`. What leaks is this machine's own layout.
    """
    import getpass
    try:
        user = re.escape(getpass.getuser())
    except Exception:
        user = r"[a-z_][a-z0-9_-]*"
    return (
        r"(?:^|[\s\"'`=(\[,;:])(?:/home/" + user + r"|/Users/" + user + r")/"
    )


HOME_PATH_PATTERN = home_path_pattern()


def fold(text):
    """ASCII-fold and lowercase: `Írón` and `iron` become the same string.

    The env-marker check must catch a name written with its diacritics, and a
    name is written with diacritics exactly when it is written correctly. The
    result is used for MATCHING only — findings always report the original
    line — so the index shifts folding introduces do not matter.
    """
    import unicodedata
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(c for c in decomposed if not unicodedata.combining(c)).lower()


def identity_markers(cwd):
    """This machine's identity tokens, resolved at run time.

    Sources, in the order they are trusted: the local part of the repository's
    resolved `git config user.email` and `git config user.name` (tokens of four
    or more letters — on this machine the email local part is the ONLY place
    the user's actual name appears, the GECOS field being empty), the login
    name, and the hostname in full plus its first dot label.

    Returns (sorted tokens, missing-source notes). The notes are the gate's
    honesty obligation: an unresolved source is a partially blind category and
    must be announced, never folded into a clean result.

    The full email address is carried as its own token — it is identity even
    where its individual parts are too short or too generic to be.
    """
    tokens, missing = set(), []

    def name_tokens(text, min_len):
        out = set()
        for tok in re.split(r"[^a-z]+", fold(text or "")):
            if len(tok) >= min_len and tok not in MARKER_STOPLIST:
                out.add(tok)
        return out

    email = sh(["git", "config", "user.email"], cwd=cwd).strip()
    name = sh(["git", "config", "user.name"], cwd=cwd).strip()
    if email:
        tokens |= name_tokens(email.split("@")[0], 4)
        tokens.add(fold(email))
    else:
        missing.append("git user.email unset — its tokens are not searched")
    if name:
        tokens |= name_tokens(name, 4)
    else:
        missing.append("git user.name unset — its tokens are not searched")

    try:
        import getpass
        user = fold(getpass.getuser())
    except Exception:
        user = ""
        missing.append("local username unavailable")
    if len(user) >= 2 and user not in MARKER_STOPLIST:
        tokens.add(user)

    try:
        import socket
        host = fold(socket.gethostname())
    except Exception:
        host = ""
        missing.append("hostname unavailable")
    for part in ([host, host.split(".")[0]] if host else []):
        if len(part) >= 3 and part not in MARKER_STOPLIST:
            tokens.add(part)

    return sorted(tokens), missing


class _EnvMarkerCheck:
    """A word-boundary match on FOLDED text.

    The word boundary is the load-bearing half. Measured on this repository
    before the gate was written: the tree legitimately carries the author's
    PUBLIC account handle inside `github.com/<handle>/...` clone URLs — one
    unbroken word, no boundary — while prose uses of the name carry boundaries
    and must fire. Substring matching would have flagged the deliberate URLs
    and made the gate unusable on day one. That the handle stays clean is
    stated in the spec as the rule, not left to look like an accident; a
    `literal:` allow entry closes it for anyone who wants it closed.
    """

    def __init__(self, tokens):
        self._rx = (re.compile(r"\b(" + "|".join(re.escape(t) for t in tokens) + r")\b")
                    if tokens else None)

    def search(self, line):
        if self._rx is None:
            return None
        return self._rx.search(fold(line))


def _looks_synthetic(digits):
    """Is this a placeholder rather than somebody's number?

    Documentation is FULL of E.164 examples and demo data, and a gate that
    reports 101 findings of which 101 are `+36301234567` is a gate that gets
    muted — which costs the one real number it was built to find. Measured
    across two public repos on 2026-08-19: exactly that ratio.
    """
    body = digits[-9:]
    if len(set(body)) <= 3:                       # 000000000, 121212121
        return True
    if re.search(r"(\d)\1{3}", body):             # 1112222 → four of a kind
        return True
    runs = sum(1 for a, b in zip(body, body[1:]) if int(b) - int(a) == 1)
    if runs >= 4:                                 # 1234567
        return True
    if "555" in body:                             # reserved for fiction
        return True
    return False


class _PhoneCheck:
    """A phone-shaped string that does not look like a placeholder."""

    _rx = re.compile(PHONE_PATTERN)

    def search(self, line):
        m = self._rx.search(line)
        if not m:
            return None
        digits = re.sub(r"\D", "", m.group(0))
        return None if _looks_synthetic(digits) else m


def sh(args, cwd=None):
    """Run a command, return stdout. Never raises — not on a non-zero exit, and
    not on a binary that is not installed.

    The second half was added after a measured crash: `remote_visibility` shells
    out to `gh`, which is optional and absent on this machine, and the resulting
    `FileNotFoundError` propagated out of `main` and killed the whole scan. The
    fail direction is what makes it worth a comment — `set-hook-leakscan` blocks
    on any non-zero exit, so the crash did NOT let anything through. It reported
    the push as carrying content that must not leave the repository, which is a
    different and false statement, and the operator is then debugging a leak that
    does not exist. A missing optional tool must read as "this could not be
    determined" (the caller already defaults to "unknown"), never as a finding.
    """
    try:
        p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    except (FileNotFoundError, NotADirectoryError, PermissionError):
        return ""
    return p.stdout


def load_allow():
    allow = set(BUILTIN_ALLOW)
    if os.path.exists(ALLOWLIST):
        for line in open(ALLOWLIST, encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#"):
                allow.add(line.lower())
    return allow


def private_slugs():
    """Consumer slugs, resolved at run time. Returns (slugs, note-or-None).

    The note is non-None when the list could not be built. Callers must surface
    it rather than treating an empty list as "nothing to look for".
    """
    if not os.path.exists(REGISTRY):
        return set(), f"registry not found ({REGISTRY}) — consumer-name check SKIPPED"
    try:
        data = json.load(open(REGISTRY, encoding="utf-8"))
    except (ValueError, OSError) as exc:
        return set(), f"registry unreadable ({exc}) — consumer-name check SKIPPED"

    projects = data.get("projects", data)
    if not isinstance(projects, dict):
        return set(), "registry has an unexpected shape — consumer-name check SKIPPED"

    allow = load_allow()
    slugs = set()
    for name, meta in projects.items():
        path = (meta or {}).get("path", "") if isinstance(meta, dict) else ""
        # An E2E scaffold living inside a set-* checkout is this project's own
        # fixture, not a consumer.
        if "/e2e-runs/" in path or "/tests/e2e/" in path:
            continue
        candidates = {name}
        if path:
            candidates.add(os.path.basename(path.rstrip("/")))
        for c in candidates:
            c = re.sub(r"-run\b.*$", "", c)
            c = re.sub(r"-\d{8}-\d{4}$", "", c).lower()
            if len(c) >= 5 and not c.startswith("set-") and c not in allow:
                slugs.add(c)
    return slugs, None


# Categories that matter whatever the remote's visibility. A credential is a
# credential in a private repository too, and a file that is gitignored yet
# tracked is a mistake wherever it lives — that exact shape shipped a real phone
# number for weeks from a repo whose author believed the ignore rule had worked.
ALWAYS_ENFORCED = ("secret:", "ignored-but-tracked")

VIS_CACHE = os.path.join(HOME, ".cache", "set-core", "leakscan-visibility.json")


def remote_visibility(cwd):
    """Is anything this repository pushes to publicly readable?

    Returns "public", "private", or "unknown". UNKNOWN IS TREATED AS PUBLIC by
    the caller: a gate that guesses "private" when it cannot tell fails in the
    direction that publishes.

    Why this exists at all: without it the gate reported 654 findings inside a
    private project that legitimately names the client projects it coordinates —
    that is its job, and none of it leaves a private remote. A gate that cries
    on every push in the repositories somebody actually works in is a gate that
    gets removed, and it takes the public-repo protection with it.

    Not consulted in commit mode: a commit is history whoever can see the
    remote, and skipping the `gh` subprocesses is part of what keeps a
    pre-commit call fast.
    """
    urls = sorted({u for u in sh(["git", "remote", "-v"], cwd=cwd).split()
                   if "://" in u or "@" in u})
    if not urls:
        return "unknown"
    try:
        cache = json.load(open(VIS_CACHE, encoding="utf-8"))
    except (OSError, ValueError):
        cache = {}

    verdicts, dirty = [], False
    for url in urls:
        if url in cache:
            verdicts.append(cache[url])
            continue
        v = "unknown"
        if "github.com" in url:
            slug = url.split("github.com")[-1].lstrip(":/").removesuffix(".git")
            out = sh(["gh", "repo", "view", slug, "--json", "visibility",
                      "-q", ".visibility"]).strip().lower()
            if out in ("public", "private", "internal"):
                v = "public" if out == "public" else "private"
        cache[url] = v
        verdicts.append(v)
        dirty = True

    if dirty:
        try:
            os.makedirs(os.path.dirname(VIS_CACHE), exist_ok=True)
            payload = json.dumps(cache, indent=1)      # render BEFORE opening
            with open(VIS_CACHE, "w", encoding="utf-8") as fh:
                fh.write(payload)
        except OSError:
            pass

    if "public" in verdicts:
        return "public"
    if all(v == "private" for v in verdicts):
        return "private"
    return "unknown"


def tracked_files(cwd):
    out = sh(["git", "ls-files", "-z"], cwd=cwd)
    return [f for f in out.split("\0") if f]


def _scan_pairs(pairs, path, checks, findings):
    """Match every check against (line number, text) pairs of one path.

    The shared inner loop of whole-file and added-line scanning. One finding
    per line, first matching category wins — the same shape the whole-file
    scanner has always had.
    """
    for lineno, line in pairs:
        if len(line) > 4000:
            line = line[:4000]
        for label, rx in checks:
            if rx.search(line):
                findings.append({
                    "category": label, "file": path,
                    "line": lineno, "text": line.strip()[:160],
                })
                break


def _scan_text(lines, path, checks, findings):
    _scan_pairs(enumerate(lines, 1), path, checks, findings)


def scan_blob(cwd, path, checks, findings, self_paths):
    if path in self_paths:
        return  # the scanner's own patterns are not findings — see module docstring
    full = os.path.join(cwd, path)
    # Binary files produce byte soup that matches loose patterns — a GIF matched
    # the phone-number shape twice here. Noise is not harmless in a gate: it is
    # how the gate stops being read. A NUL byte in the first block is the same
    # heuristic git itself uses to call a file binary.
    try:
        with open(full, "rb") as bh:
            if b"\0" in bh.read(8000):
                return
    except OSError:
        return
    try:
        with open(full, encoding="utf-8", errors="replace") as fh:
            _scan_text(fh, path, checks, findings)
    except (OSError, UnicodeError):
        pass


HUNK_RX = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)")


def diff_added_lines(cwd, diff_args):
    """Added lines per path as (FILE line number, text), from ONE diff run.

    The env-marker category's line source in staged and range modes. One
    subprocess per scan, not per file — a pre-commit hook that shells out once
    per staged file is a hook people wait for and then disable.

    The number comes from the hunk header's `+start`, not from enumerating the
    collected lines: the first version reported its list index wearing a line
    number, and a finding that names the wrong line is a false value — the
    whole-file scanner reports true file lines, and this one must not lie
    where it points.
    """
    out = sh(["git", "diff", *diff_args, "-U0"], cwd=cwd)
    result, current, lineno = {}, None, 0
    for line in out.splitlines():
        if line.startswith("+++ b/"):
            current = line[len("+++ b/"):]
            lineno = 0
        elif line.startswith("+++ "):
            current = None            # /dev/null — a deletion adds nothing
        elif line.startswith("@@"):
            m = HUNK_RX.match(line)
            lineno = int(m.group(1)) if (m and current) else 0
        elif line.startswith("+") and current:
            result.setdefault(current, []).append((lineno, line[1:]))
            lineno += 1
    return result


def staged_entries(cwd):
    """(path, status-letter) pairs for the staged diff, NUL-safe."""
    fields = sh(["git", "diff", "--cached", "--name-status", "-z"], cwd=cwd).split("\0")
    entries, i = [], 0
    while i < len(fields):
        f = fields[i]
        if not f:
            i += 1
            continue
        if f and f[0] in "RC":          # R100 <old> <new> / CNN <old> <new>
            if i + 2 < len(fields):
                entries.append((fields[i + 2], f[0]))
            i += 3
        else:
            if i + 1 < len(fields):
                entries.append((fields[i + 1], f[0]))
            i += 2
    return entries


# ─── the hook installer ──────────────────────────────────────────────
# The shipped pre-push header has said "Installed by set-leakscan" since the
# gate first shipped, but the installer itself did not exist — hooks were
# hand-installed, and a fresh clone had none. `--install-hooks` makes the
# claim true. Marker-guarded: a hook that exists without the marker was
# written by a human and is NEVER touched.

HOOK_MARKER = "# Installed by set-leakscan."

_HOOK_BODY_PREFIX = """#!/usr/bin/env bash
""" + HOOK_MARKER + """ {purpose}
#
# The scan reads its lists from the local machine at run time — nothing
# identifying is stored in this repository.
#
# NEVER bypass with --no-verify: fix the finding, or record a deliberate
# exception in ~/.config/set-core/leakscan-allow.txt and say so out loud.
if ! command -v set-leakscan >/dev/null 2>&1; then
  echo "{name}: set-leakscan not found on PATH — refusing blind." >&2
  echo "          A gate that cannot run must not report clean." >&2
  exit 1
fi
"""

HOOK_TEMPLATES = {
    "pre-commit": _HOOK_BODY_PREFIX.format(
        name="pre-commit",
        purpose="Refuses a commit whose STAGED content introduces environment-specific\n"
                "# identity (name, username, email, hostname), a consumer name, a credential\n"
                "# or a phone number — regardless of remote visibility.",
    ) + "exec set-leakscan --staged\n",
    "commit-msg": _HOOK_BODY_PREFIX.format(
        name="commit-msg",
        purpose="Refuses a commit MESSAGE carrying environment-specific identity, a\n"
                "# consumer name or a credential — before the commit exists.",
    ) + 'exec set-leakscan --message "$1"\n',
    "pre-push": _HOOK_BODY_PREFIX.format(
        name="pre-push",
        purpose="Refuses a push that would publish a consumer name, a credential, a local\n"
                "# filesystem path or a phone number.",
    ) + 'exec set-leakscan --range "$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo HEAD)..HEAD"\n',
}


def install_hooks():
    """Write the three hooks, marker-guarded and idempotent."""
    git_dir = sh(["git", "rev-parse", "--git-path", "hooks"]).strip()
    if not git_dir:
        print("set-leakscan --install-hooks: not inside a git repository",
              file=sys.stderr)
        return 2
    git_dir = os.path.abspath(git_dir)
    os.makedirs(git_dir, exist_ok=True)

    written, fresh, untouched = [], [], []
    for name, body in HOOK_TEMPLATES.items():
        path = os.path.join(git_dir, name)
        if os.path.exists(path):
            try:
                content = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                content = ""
            if HOOK_MARKER not in "\n".join(content.splitlines()[:3]):
                untouched.append(name)
                continue          # a human wrote this hook; it is not ours to touch
            if content == body:
                fresh.append(name)   # already in place — AC: report, don't rewrite
                continue
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
        os.chmod(path, 0o755)
        written.append(name)

    for name in written:
        print(f"  wrote   .git/hooks/{name}")
    for name in fresh:
        print(f"  in place .git/hooks/{name}")
    for name in untouched:
        print(f"  LEFT UNTOUCHED .git/hooks/{name} — no installer marker; "
              f"a hand-written hook is never overwritten")
    if untouched:
        print("  (the scan does not run through that hook — wire it up by hand "
              "if it should)")
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--range", dest="rev_range", default=None)
    ap.add_argument("--staged", action="store_true")
    ap.add_argument("--tree", action="store_true",
                    help="scan the whole tracked tree, not only the range")
    ap.add_argument("--message", dest="message_file", default=None, metavar="FILE",
                    help="scan one commit-message file (commit-msg hook)")
    ap.add_argument("--install-hooks", dest="install_hooks", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--list-patterns", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()

    if args.help:
        print(__doc__)
        return 0

    if args.install_hooks:
        return install_hooks()

    slugs, skip_note = private_slugs()

    if args.list_patterns:
        cwd = sh(["git", "rev-parse", "--show-toplevel"]).strip()
        env_tokens, env_missing = identity_markers(cwd) if cwd else ([],
            ["not inside a git repository"])
        print("categories: consumer-name, secret, home-path, phone, env-marker")
        print(f"consumer-name patterns resolved at run time: {len(slugs)}")
        print(f"  source   : {REGISTRY}")
        print(f"  allowlist: {ALLOWLIST}")
        print(f"env-marker tokens resolved at run time: {len(env_tokens)}")
        print("  sources  : git user.email local part, git user.name, username, hostname")
        print("  measured : added lines only — never whole files, never --tree")
        print("  (values deliberately not printed — that is the thing being protected)")
        if skip_note:
            print(f"  WARNING  : {skip_note}")
        for note in env_missing:
            print(f"  WARNING  : {note}")
        return 0

    mode = ("message" if args.message_file
            else "staged" if args.staged
            else "tree" if args.tree
            else "range")

    cwd = sh(["git", "rev-parse", "--show-toplevel"]).strip()
    if not cwd:
        print("set-leakscan: not inside a git repository", file=sys.stderr)
        return 2

    self_paths = {"bin/set-leakscan", ".claude/rules/release-safety.md"}

    # A REPOSITORY MAY NAME ITSELF. Without this, running the gate inside one of
    # the private projects reports its own name on every line that mentions it —
    # 893 findings in one measured case, which is not a leak in any direction and
    # would make the gate unusable exactly where somebody most needs to push.
    own = {os.path.basename(cwd).lower()}
    for url in sh(["git", "remote", "-v"], cwd=cwd).split():
        if "/" in url or ":" in url:
            tail = url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]
            if tail.endswith(".git"):
                tail = tail[:-4]
            if tail:
                own.add(tail.lower())
    slugs = {s for s in slugs if s not in own}

    env_tokens, env_missing = identity_markers(cwd)
    env_tokens = [t for t in env_tokens if t not in own]

    checks = []                    # whole-file checks — env-marker is never one
    if slugs:
        checks.append(("consumer-name",
                       re.compile(r"\b(" + "|".join(re.escape(s) for s in sorted(slugs)) + r")\b",
                                  re.IGNORECASE)))
    for label, rx in SECRET_PATTERNS:
        checks.append((f"secret:{label}", re.compile(rx)))
    checks.append(("home-path", re.compile(HOME_PATH_PATTERN)))
    checks.append(("phone", _PhoneCheck()))

    env_check = _EnvMarkerCheck(env_tokens) if env_tokens else None
    # New files and added lines get the env-marker check too — for a new file
    # every line is an added line, so the whole-file scan may as well carry it.
    commit_checks = checks + ([("env-marker", env_check)] if env_check else [])

    findings = []
    added = {}                     # path -> added lines (staged / range modes)

    # --- which content -------------------------------------------------------
    if mode == "message":
        try:
            with open(args.message_file, encoding="utf-8", errors="replace") as fh:
                _scan_text(fh, "<commit-message>", commit_checks, findings)
        except OSError as exc:
            print(f"set-leakscan: message file unreadable ({exc}) — refusing",
                  file=sys.stderr)
            return 2
        files = []
    elif mode == "staged":
        entries = staged_entries(cwd)
        added = diff_added_lines(cwd, ["--cached"])
        new_paths = {p for p, s in entries if s in "AC"}
        for f in sorted(new_paths):
            scan_blob(cwd, f, commit_checks, findings, self_paths)
        for path, pairs in added.items():
            if path in new_paths:
                continue           # already scanned whole
            _scan_pairs(pairs, path, commit_checks, findings)
        files = [p for p, _ in entries]
    elif mode == "tree":
        files = tracked_files(cwd)
        for f in files:
            scan_blob(cwd, f, checks, findings, self_paths)
    else:
        rng = args.rev_range
        if not rng:
            up = sh(["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
                    cwd=cwd).strip()
            rng = f"{up}..HEAD" if up else None
        if rng:
            files = [f for f in sh(["git", "diff", "--name-only", "-z", rng],
                                   cwd=cwd).split("\0") if f]
            added = diff_added_lines(cwd, [rng])
        else:
            files = tracked_files(cwd)
        args.rev_range = rng
        for f in files:
            scan_blob(cwd, f, checks, findings, self_paths)
        if env_check:
            # Range mode: whole-file scanning above carries the pre-existing
            # categories; the env-marker category measures ONLY what the range
            # adds. Old contamination the range does not touch must not block.
            for path, pairs in added.items():
                if path in self_paths:
                    continue
                _scan_pairs(pairs, path, [("env-marker", env_check)], findings)

    # --- file NAMES ----------------------------------------------------------
    name_checks = ([("consumer-name", checks[0][1])] if slugs else []) + \
                  ([("env-marker:filename", env_check)] if env_check else [])
    if mode in ("staged", "range", "tree"):
        for f in files:
            for label, rx in name_checks:
                if rx.search(f):
                    findings.append({"category": label, "file": f, "line": 0, "text": f})

    # --- commit and tag MESSAGES --------------------------------------------
    # A message is in no diff and in no tree, so the content checks above are
    # structurally blind to it. (Staged and message modes are excluded: staged
    # is the pre-commit fast path, and message mode IS the message scan.)
    if slugs and mode in ("range", "tree"):
        rng = args.rev_range
        log_args = ["git", "log", "--format=%H%x1f%s%n%b%x1e"]
        log_args.append(rng if rng else "--all")
        for entry in sh(log_args, cwd=cwd).split("\x1e"):
            if "\x1f" not in entry:
                continue
            sha, msg = entry.split("\x1f", 1)
            if checks[0][1].search(msg):
                findings.append({"category": "consumer-name:commit-message",
                                 "file": sha.strip()[:12], "line": 0,
                                 "text": msg.strip().splitlines()[0][:160] if msg.strip() else ""})
        for tagline in sh(["git", "tag", "-l", "-n99"], cwd=cwd).splitlines():
            if checks[0][1].search(tagline):
                findings.append({"category": "consumer-name:tag-message",
                                 "file": tagline.split()[0] if tagline.split() else "?",
                                 "line": 0, "text": tagline[:160]})

    # --- ignored BUT tracked -------------------------------------------------
    # A path listed in .gitignore that is nevertheless tracked was added before
    # the ignore rule and still ships on every push.
    # `--no-index` is load-bearing: without it git refuses to call a TRACKED
    # path ignored, so the check answers "clean" for exactly the condition it
    # exists to find. The instrument hit the wall it was built to measure and
    # returned a reassuring zero — caught by a unit test, not by inspection.
    # Skipped in the commit modes: it walks every tracked file with one
    # subprocess each, and a pre-commit hook must cost milliseconds.
    if mode in ("range", "tree"):
        for f in tracked_files(cwd):
            if subprocess.run(["git", "check-ignore", "--no-index", "-q", f],
                              cwd=cwd).returncode == 0:
                findings.append({"category": "ignored-but-tracked",
                                 "file": f, "line": 0, "text": f})

    # --- deliberate exceptions -------------------------------------------
    # The allow file holds slugs for the name check, but the same entries also
    # suppress ANY finding whose matched line contains them. That is what makes
    # the file a usable escape hatch: a vendor's documentation phone number
    # (Twilio ships one in every code sample) is not a slug, and without a way
    # to record it the gate reports it forever and is eventually ignored.
    # A plain entry is a SLUG and only silences the name check (it is already
    # applied there). An entry prefixed `literal:` silences any finding whose
    # line contains it. The two must stay separate: the first version let a
    # slug suppress by substring, and the allowlisted repo name `ikp` promptly
    # swallowed a REAL `/home/<user>/code2/ikp/...` path finding in that very
    # repository — a fix that opened a hole one line wider than the one it shut.
    allow_literals = {a[len("literal:"):] for a in load_allow()
                      if a.startswith("literal:")}
    if allow_literals:
        findings = [f for f in findings
                    if not any(a in f["text"].lower() for a in allow_literals)]

    # --- what actually blocks --------------------------------------------
    if mode in ("staged", "message"):
        # A commit is history whoever can see the remote — publication is only
        # one of the ways content escapes, and by the time it publishes the
        # repair is a rewrite. Everything blocks; visibility is not consulted.
        visibility = "not consulted (commit gate)"
        blocking = findings
    else:
        visibility = remote_visibility(cwd)
        if visibility == "private":
            blocking = [f for f in findings
                        if f["category"].startswith(ALWAYS_ENFORCED)]
        else:
            blocking = findings

    # --- report --------------------------------------------------------------
    if args.json:
        print(json.dumps({"findings": findings, "blocking": blocking,
                          "visibility": visibility, "skipped": skip_note,
                          "env_marker_sources_missing": env_missing,
                          "mode": mode, "scanned_files": len(files)}, indent=2))
    elif not args.quiet or findings or skip_note:
        if skip_note:
            print(f"⚠ set-leakscan: {skip_note}", file=sys.stderr)
        for note in env_missing:
            print(f"⚠ set-leakscan: env-marker check partially blind — {note}",
                  file=sys.stderr)
        if findings:
            mark = "✖" if blocking else "•"
            head = (f"{mark} set-leakscan: {len(findings)} finding(s) — "
                    f"{'COMMIT REFUSED' if mode == 'staged' else 'commit message REFUSED' if mode == 'message' else f'{len(files)} scanned file(s), remote is {visibility}'}")
            print(head, file=sys.stderr)
            print("", file=sys.stderr)
            by_cat = {}
            for f in findings:
                by_cat.setdefault(f["category"], []).append(f)
            blocking_cats = {f["category"] for f in blocking}
            for cat, items in sorted(by_cat.items()):
                tag = "BLOCKS" if cat in blocking_cats else "advisory"
                print(f"  {cat} ({len(items)}) [{tag}]", file=sys.stderr)
                for it in items[:8]:
                    loc = f"{it['file']}:{it['line']}" if it["line"] else it["file"]
                    print(f"    {loc}  {it['text']}", file=sys.stderr)
                if len(items) > 8:
                    print(f"    … and {len(items) - 8} more", file=sys.stderr)
            if blocking:
                if mode in ("staged", "message"):
                    print("\n  Environment-specific content does not belong in history. If the value is",
                          file=sys.stderr)
                    print("  legitimately machine-local, move it to local config "
                          "(set-config set <key> <value>,", file=sys.stderr)
                    print(f"  stored under ~/.config/set-core/ — never committed) or record a deliberate",
                          file=sys.stderr)
                    print(f"  exception in {ALLOWLIST} as a `literal:` line and say so out loud.",
                          file=sys.stderr)
                else:
                    print("\n  Nothing is pushed. Fix the findings, or record a deliberate",
                          file=sys.stderr)
                    print(f"  exception in {ALLOWLIST} (one slug per line).", file=sys.stderr)
            else:
                # Reported, not enforced — and SAID so. A gate that silently
                # downgrades itself is indistinguishable from one that found
                # nothing, which is the shape this whole tool exists to refuse.
                print("\n  Every remote of this repository is private, so the findings above",
                      file=sys.stderr)
                print("  are reported and NOT enforced. They still matter the day a remote",
                      file=sys.stderr)
                print("  becomes public — nothing about them is retroactive.", file=sys.stderr)
        elif not args.quiet:
            n_marks = len(slugs) + len(env_tokens)
            print(f"✔ set-leakscan: clean ({len(files)} file(s), "
                  f"{n_marks} pattern(s), remote {visibility})")

    return 1 if blocking else 0


if __name__ == "__main__":
    sys.exit(main())
