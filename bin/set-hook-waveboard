#!/usr/bin/env python3
"""set-hook-waveboard — Claude Code Stop hook: make the agent push a wave board.

A wave board's live data is a claude.ai Artifact database, and only the agent can write
it. This hook runs `set-wave-board sync` on every Stop and, when a job's payload differs
from what this machine last pushed, blocks the stop ONCE with the exact push procedure —
so the push happens whether or not the agent remembered the board.

It also asks for a REVIEW of a stale board: one whose items only an agent can move (no
evidence, or blocked) are open while HEAD has moved on since the board last changed
(`set-wave-board stale`). Sync cannot move those items, so before this the board simply
froze. The review has its own backoff (SET_WAVEBOARD_REVIEW_SECONDS, 14400) and its own
switch (SET_WAVEBOARD_REVIEW=off). When both are due, one block carries both, push first.

Silent (exit 0, no output) when:
  - the Stop event carries `stop_hook_active: true` (the continuation this hook caused),
  - SET_WAVEBOARD_PUSH is off / 0 / false / no,
  - the working directory is not in a git repository, or it has no docs/waveboard/,
  - it is a linked git worktree (unless SET_WAVEBOARD_PUSH=worktree): the board follows
    the main checkout, and worktree agents are usually orchestrated ones,
  - the job was already reminded within the backoff (SET_WAVEBOARD_NAG_SECONDS, 1800),
  - anything at all goes wrong: a Stop hook that errors is noise on every turn.

Never touches the network. The sync runs under a timeout well inside the hook's own.

Designed to be referenced by name in .claude/settings.json ("command": "set-hook-waveboard");
on PATH through install.sh.
"""
from __future__ import annotations

import json
import logging
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

logger = logging.getLogger("set-hook-waveboard")

SYNC_TIMEOUT = 10
#: Sync and the staleness check share one budget, inside the 15 s the deployed settings give
#: the hook: the check gets only what the sync left over.
BUDGET = 12.0
OFF = ("off", "0", "false", "no")


def _tool() -> str | None:
    sibling = Path(os.path.realpath(__file__)).parent / "set-wave-board"
    if sibling.is_file() and os.access(sibling, os.X_OK):
        return str(sibling)
    return shutil.which("set-wave-board")


def _root(cwd: str, allow_worktree: bool) -> Path | None:
    """The main checkout's root, or None (not a repo, or a linked worktree)."""
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel", "--absolute-git-dir",
                            "--git-common-dir"], cwd=cwd, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        logger.debug("git rev-parse failed: %s", e)
        return None
    lines = r.stdout.strip().splitlines()
    if r.returncode != 0 or len(lines) < 3:
        return None
    top, git_dir, common = lines[0], lines[1], lines[2]
    # a relative --git-common-dir is relative to cwd, not to the top level
    common_abs = os.path.realpath(os.path.join(cwd, common))
    if not allow_worktree and os.path.realpath(git_dir) != common_abs:
        # A linked worktree holds a branch's copy of the job file. Pushing from it and from
        # the main checkout would flip the board between two branches' evidence, and the
        # agents that run in worktrees are usually orchestrated ones with no Artifact access.
        logger.debug("linked worktree, skipping: %s", top)
        return None
    return Path(top)


def _backoff() -> float:
    try:
        return float(os.environ.get("SET_WAVEBOARD_NAG_SECONDS", "1800"))
    except ValueError:
        return 1800.0


def procedure(root: Path, jobs: list, backoff: float) -> str:
    lines = [
        f"Wave board: {len(jobs)} push(es) from this repository have state this machine has not "
        "pushed to the board pages. Push each one now with your ArtifactData tool, then carry on "
        "where you left off.",
    ]
    for r in jobs:
        version = r.get("pushed_version")
        pin = (f"if_version={version}" if version else
               "no if_version (no push is recorded on this machine, so this creates the document)")
        combined = r.get("target") == "combined"
        lines += [
            "",
            (f"Job `{r['job']}` on the COMBINED board (every project's boards, one document each):"
             if combined else f"Job `{r['job']}`:"),
            f"1. ArtifactData action=set, url={r['url']}, collection={r['collection']}, doc_id={r['doc']}, "
            f"file_path={r['payload']}, {pin}.",
            "2. If the write is refused because the document changed or already exists: "
            f"ArtifactData action=get, url={r['url']}, collection={r['collection']}, doc_id={r['doc']}; "
            "then redo step 1 with if_version set to the version that get returned.",
            f"3. Then run: set-wave-board pushed {r['job']} --repo {root}"
            + (" --combined" if combined else "")
            + f" --version <the version the set returned> --hash {r['hash']}",
        ]
    minutes = int(backoff // 60)
    owner = _owner_account()
    who = (f"the board's owner account, {owner} (from the wave-board editor list)" if owner
           else "the account that published the board")
    lines += [
        "",
        "Send the file as it is; do not retype or edit the payload. If the write is refused "
        "because this account cannot write the artifact (only its owner and the editors it was "
        f"shared with can), do not switch this reminder off: ask {who} to share the board with "
        "this account with edit access (claude.ai: open the board, Share). Say so in one line and "
        f"continue — this reminder backs off for {minutes} minutes per job.",
    ]
    return "\n".join(lines)


def _owner_account() -> str | None:
    """`owner_account` from the machine-local editor list (`set-wave-board` reads the same file)."""
    env = os.environ.get("SET_WAVEBOARD_EDITORS", "").strip()
    path = Path(env).expanduser() if env else Path.home() / ".config" / "set-core" / "waveboard-editors.json"
    try:
        owner = json.loads(path.read_text(encoding="utf-8")).get("owner_account")
    except (OSError, ValueError, AttributeError):
        return None
    return owner.strip() if isinstance(owner, str) and owner.strip() else None


def main() -> int:
    logging.basicConfig(level=logging.DEBUG if os.environ.get("SET_WAVEBOARD_DEBUG") else logging.WARNING,
                        format="set-hook-waveboard: %(levelname)s %(message)s", stream=sys.stderr)
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        event = {}
    if not isinstance(event, dict):
        event = {}
    if event.get("stop_hook_active"):
        return 0
    mode = os.environ.get("SET_WAVEBOARD_PUSH", "").strip().lower()
    if mode in OFF:
        return 0
    root = _root(event.get("cwd") or os.getcwd(), allow_worktree=(mode == "worktree"))
    if root is None or not (root / "docs" / "waveboard").is_dir():
        return 0
    tool = _tool()
    if not tool:
        logger.debug("set-wave-board not found")
        return 0
    deadline = time.monotonic() + BUDGET
    try:
        r = subprocess.run([tool, "sync", "--repo", str(root), "--json"], capture_output=True,
                           text=True, timeout=SYNC_TIMEOUT)
        results = json.loads(r.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        logger.debug("sync failed: %s", e)
        return 0
    pending = push_entries(results)
    stale = _stale(tool, root, deadline - time.monotonic()) if mode_review_on() else []

    now = time.time()
    state = root / ".set" / "waveboard"
    backoff, review_backoff = _backoff(), _review_backoff()
    due = _due(state, pending, "nag", backoff, now)
    review_due = _due(state, stale, "review-nag", review_backoff, now)
    if not due and not review_due:
        return 0
    _stamp(state, due, "nag", now)
    _stamp(state, review_due, "review-nag", now)
    # One block per Stop: the push first, because the review may change the payload and the
    # next Stop then asks for that push (design D7).
    parts = []
    if due:
        parts.append(procedure(root, due, backoff))
    if review_due:
        parts.append(review_procedure(root, review_due, review_backoff))
    print(json.dumps({"decision": "block", "reason": "\n\n".join(parts)}))
    return 0


def mode_review_on() -> bool:
    return os.environ.get("SET_WAVEBOARD_REVIEW", "").strip().lower() not in OFF


def _review_backoff() -> float:
    try:
        return float(os.environ.get("SET_WAVEBOARD_REVIEW_SECONDS", "14400"))
    except ValueError:
        return 14400.0


def _stale(tool: str, root: Path, budget: float) -> list:
    """The stale jobs, from `set-wave-board stale --json`; empty on any failure."""
    if budget < 1.0:
        logger.debug("no time left for the staleness check (%.1fs)", budget)
        return []
    try:
        r = subprocess.run([tool, "stale", "--repo", str(root), "--json"], capture_output=True,
                           text=True, timeout=min(SYNC_TIMEOUT, budget))
        results = json.loads(r.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        logger.debug("stale failed: %s", e)
        return []
    return [x for x in results if isinstance(x, dict) and x.get("stale")]


def push_entries(results: list) -> list:
    """One entry per write the agent owes: the board's own page, and the combined board."""
    entries = []
    for x in results:
        if not isinstance(x, dict):
            continue
        if x.get("push_needed"):
            entries.append({"job": x["job"], "target": "board", "url": x["artifact_url"],
                            "collection": "board", "doc": "state", "payload": x["payload"],
                            "pushed_version": x.get("pushed_version"), "hash": x["content_hash"],
                            "nag_key": x["job"]})
        if x.get("combined_push_needed"):
            entries.append({"job": x["job"], "target": "combined", "url": x["combined_url"],
                            "collection": "boards", "doc": x["combined_doc"],
                            "payload": x["combined_payload"],
                            "pushed_version": x.get("combined_pushed_version"),
                            "hash": x["combined_hash"], "nag_key": f"{x['job']}.combined"})
    return entries


def _due(state: Path, jobs: list, suffix: str, backoff: float, now: float) -> list:
    due = []
    for x in jobs:
        try:
            last = float((state / f"{x.get('nag_key', x['job'])}.{suffix}").read_text().strip())
        except (OSError, ValueError):
            last = 0.0
        if now - last >= backoff:
            due.append(x)
    return due


def _stamp(state: Path, jobs: list, suffix: str, now: float) -> None:
    for x in jobs:
        try:
            state.mkdir(parents=True, exist_ok=True)
            (state / f"{x.get('nag_key', x['job'])}.{suffix}").write_text(f"{int(now)}\n")  # floor: a stamp rounded up lies in the future
        except OSError as e:
            logger.debug("cannot write %s stamp for %s: %s", suffix, x["job"], e)


MAX_LISTED = 20


def review_procedure(root: Path, jobs: list, backoff: float) -> str:
    lines = [
        f"Wave board review: {len(jobs)} board(s) in this repository look stale. The repository "
        "has moved on since the board last changed, and the items below are ones only you can "
        "move (no evidence, or blocked). Check each against what was actually done, then carry "
        "on where you left off.",
    ]
    for r in jobs:
        items = r.get("manual_open") or []
        lines += ["", f"Job `{r['job']}`: {r.get('commits_since_change')} commit(s) on HEAD since "
                      f"its last change ({r.get('last_change')}). Items only you can move:"]
        for it in items[:MAX_LISTED]:
            lines.append(f"  - {it.get('id')} [{it.get('status')}] {it.get('title', '')}")
        if len(items) > MAX_LISTED:
            lines.append(f"  … +{len(items) - MAX_LISTED} more (`set-wave-board stale {r['job']} "
                         f"--repo {root}` lists them all)")
        lines += [
            f"For each item that moved: set-wave-board set {r['job']} <item> "
            "<todo|doing|done|blocked|skipped> [--note N] --repo " + str(root),
            f"When every listed item is still right: set-wave-board reviewed {r['job']} --repo {root}",
        ]
    lines += [
        "",
        "Both commands edit the tracked job file; commit it with your work. Do not stamp "
        "`reviewed` without checking — it only quiets the reminder until the next few commits. "
        f"This reminder backs off for {int(backoff // 60)} minutes per job; "
        "SET_WAVEBOARD_REVIEW=off silences it.",
    ]
    return "\n".join(lines)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # a Stop hook must never fail a turn
        logging.getLogger("set-hook-waveboard").debug("unexpected: %s", e)
        sys.exit(0)
