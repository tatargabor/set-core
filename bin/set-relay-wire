#!/bin/bash
# set-relay-wire — wire the question relay's hooks into registered projects.
# Machine-local only: writes <project>/.claude/settings.local.json, never a tracked file.
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
export SET_TOOLS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/set-common.sh" 2>/dev/null
PYTHON="$(find_python 2>/dev/null)" || PYTHON="python3"
exec env PYTHONPATH="$SET_TOOLS_ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" \
     "$PYTHON" -m set_orch.fleet.relay_wire_cli "$@"
