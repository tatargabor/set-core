#!/usr/bin/env bash
# set-config - Configure set-core settings

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/set-common.sh"

usage() {
    cat <<EOF
Usage: set-config <command> [options]

Commands:
  editor list           List supported editors and availability
  editor set <name>     Set preferred editor (zed, vscode, cursor, windsurf, auto)
  editor show           Show current editor configuration
  editor test           Test editor launch

  model show            Show current model prefix and resolved IDs
  model prefix <value>  Set model prefix (e.g. "cc/", "", "openrouter/")

  get <key> [--project P]     Read a local config value (env → project → machine)
  set <key> <value> [--project P]
                              Write one — stored under ~/.config/set-core/,
                              NEVER committed. This is the legitimate home for
                              a machine- or project-specific value the leak gate
                              would otherwise refuse at commit time.
  list [--project P]          Show stored keys and where each resolves from.
                              Values are masked on purpose.

Options:
  -h, --help            Show this help

Examples:
  set-config editor list
  set-config editor set vscode
  set-config model show
  set-config model prefix cc/
  set-config set tools_dir /opt/my-tools --project myapp
  set-config get tools_dir --project myapp
  set-config list
EOF
}

cmd_editor_list() {
    echo "Supported editors:"
    echo ""
    printf "  %-12s %-10s %-15s %s\n" "NAME" "STATUS" "COMMAND" "CLAUDE LAUNCH"
    printf "  %-12s %-10s %-15s %s\n" "----" "------" "-------" "-------------"

    for entry in "${SUPPORTED_EDITORS[@]}"; do
        IFS=':' read -r name cmd wclass claude_method <<< "$entry"
        local status="not found"
        local found_cmd=""
        if is_editor_installed "$name"; then
            status="${GREEN}available${NC}"
            found_cmd=$(find_editor_command "$name")
        else
            status="${RED}not found${NC}"
        fi
        printf "  %-12s %-10b %-15s %s\n" "$name" "$status" "${found_cmd:-$cmd}" "$claude_method"
    done

    echo ""
    local configured
    configured=$(get_configured_editor)
    echo "Configured: $configured"

    local active
    active=$(get_active_editor)
    if [[ -n "$active" ]]; then
        echo "Active: $active"
    else
        warn "No editor available!"
    fi
}

cmd_editor_set() {
    local editor_name="$1"

    # If no argument, show interactive selection
    if [[ -z "$editor_name" ]]; then
        cmd_editor_select
        return $?
    fi

    if ! set_configured_editor "$editor_name"; then
        return 1
    fi

    success "Editor set to: $editor_name"

    # Warn if not installed
    if [[ "$editor_name" != "auto" ]] && ! is_editor_installed "$editor_name"; then
        warn "Note: $editor_name is not currently installed"
        print_editor_install_instructions "$editor_name"
    fi
}

cmd_editor_select() {
    echo "Select editor:"
    echo ""

    local options=("auto (recommended - uses first available)")
    local values=("auto")
    local idx=1

    for entry in "${SUPPORTED_EDITORS[@]}"; do
        local name="${entry%%:*}"
        local status=""
        if is_editor_installed "$name"; then
            status=" ${GREEN}[installed]${NC}"
        else
            status=" ${RED}[not found]${NC}"
        fi
        options+=("$name$status")
        values+=("$name")
        idx=$((idx + 1))
    done

    # Print options
    for i in "${!options[@]}"; do
        printf "  %d) %b\n" "$((i + 1))" "${options[$i]}"
    done
    echo ""

    # Read selection
    local selection
    read -p "Enter number (1-${#options[@]}): " selection

    if [[ ! "$selection" =~ ^[0-9]+$ ]] || [[ "$selection" -lt 1 ]] || [[ "$selection" -gt ${#options[@]} ]]; then
        error "Invalid selection"
        return 1
    fi

    local chosen="${values[$((selection - 1))]}"
    cmd_editor_set "$chosen"
}

cmd_editor_show() {
    local configured
    configured=$(get_configured_editor)
    echo "Configured editor: $configured"

    local active
    active=$(get_active_editor)
    if [[ -n "$active" ]]; then
        echo "Active editor: $active"
        local cmd
        cmd=$(find_editor_command "$active")
        echo "Command: $cmd"
        local wclass
        wclass=$(get_editor_property "$active" "window_class")
        echo "Window class: $wclass"
        local claude
        claude=$(get_editor_property "$active" "claude_launch")
        echo "Claude launch: $claude"
    else
        warn "No editor available"
        echo ""
        echo "Install one of the supported editors:"
        for name in $(get_supported_editor_names); do
            print_editor_install_instructions "$name"
        done
    fi
}

cmd_editor_test() {
    local active
    active=$(get_active_editor)

    if [[ -z "$active" ]]; then
        error "No editor available"
        return 1
    fi

    local cmd
    cmd=$(find_editor_command "$active")

    info "Testing $active editor..."
    echo "Command: $cmd"

    # Create a temp directory to open
    local test_dir
    test_dir=$(mktemp -d)
    echo "Test file for set-config editor test" > "$test_dir/README.txt"

    info "Opening test directory: $test_dir"

    case "$active" in
        zed)
            "$cmd" -n "$test_dir"
            ;;
        vscode|cursor|windsurf)
            "$cmd" "$test_dir"
            ;;
    esac

    success "Editor launched. Close it when done testing."
    echo "Test directory: $test_dir (you can delete it)"
}

cmd_model_show() {
    local prefix
    prefix=$(get_model_prefix)
    echo "Model prefix: \"${prefix:-<none>}\""
    echo ""
    echo "Resolved model IDs:"
    echo "  haiku  → $(resolve_model_id haiku)"
    echo "  sonnet → $(resolve_model_id sonnet)"
    echo "  opus   → $(resolve_model_id opus)"
}

cmd_model_prefix() {
    local prefix="$1"
    set_model_prefix "$prefix"
    success "Model prefix set to: \"${prefix:-<none>}\""
    echo ""
    cmd_model_show
}

# ─── local config (the uncommitted home for env-specific values) ─────
# The set-core lib sits beside bin/, except under Homebrew-style installs
# where the checkout layout is preserved anyway.
LIB_DIR="$(cd "$SCRIPT_DIR/.." && pwd)/lib"

# Split "--project P" (and "--project=P") out of the remaining args.
local_project_arg() {
    PROJECT_ARG=""
    local rest=() i
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project) PROJECT_ARG="$2"; shift 2 ;;
            --project=*) PROJECT_ARG="${1#--project=}"; shift ;;
            *) rest+=("$1"); shift ;;
        esac
    done
    REST_ARGS=("${rest[@]}")
    PY_ARGS=("${rest[@]}")
    [[ -n "$PROJECT_ARG" ]] && PY_ARGS+=("$PROJECT_ARG")
    return 0   # `set -e`: the && above returns 1 when --project is absent
}

cmd_local_get() {
    local_project_arg "$@"
    local out rc=0
    # `|| rc=$?` keeps the unset exit (1) from tripping `set -e` mid-function;
    # the unset answer is reported through the return code below.
    out=$(SET_LIB_DIR="$LIB_DIR" python3 - "${PY_ARGS[@]}" <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["SET_LIB_DIR"])
from set_orch import local_config as lc
if not sys.argv[1:]:
    print("usage: set-config get <key> [--project P]", file=sys.stderr)
    sys.exit(2)
value = lc.get(sys.argv[1], project=sys.argv[2] if len(sys.argv) > 2 else None)
if value is None:
    print(f"unset: {sys.argv[1]}", file=sys.stderr)
    sys.exit(1)
print(value if isinstance(value, str) else json.dumps(value))
PYEOF
    ) || rc=$?
    if [[ $rc -eq 0 ]]; then echo "$out"; else return $rc; fi
}

cmd_local_set() {
    local_project_arg "$@"
    SET_LIB_DIR="$LIB_DIR" python3 - "${PY_ARGS[@]}" <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["SET_LIB_DIR"])
from set_orch import local_config as lc
if len(sys.argv) < 3:
    print("usage: set-config set <key> <value> [--project P]", file=sys.stderr)
    sys.exit(2)
path = lc.set_value(sys.argv[1], sys.argv[2],
                    project=sys.argv[3] if len(sys.argv) > 3 else None)
print(f"written to {path}  (0600, outside every repository — never committed)")
PYEOF
}

cmd_local_list() {
    local_project_arg "$@"
    SET_LIB_DIR="$LIB_DIR" python3 - "${PY_ARGS[@]}" <<'PYEOF'
import os, sys
sys.path.insert(0, os.environ["SET_LIB_DIR"])
from set_orch import local_config as lc
project = sys.argv[1] if len(sys.argv) > 1 else None
rows = lc.entries(project=project)
if not rows:
    print("no local config values stored")
    sys.exit(0)
print(f"{'KEY':32s} {'SHAPE':14s} SOURCE   (values masked on purpose)")
for key, shape, path in rows:
    print(f"{key:32s} {shape:14s} {path}")
PYEOF
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        editor)
            if [[ $# -eq 0 ]]; then
                cmd_editor_show
                exit 0
            fi
            local subcmd="$1"
            shift
            case "$subcmd" in
                list) cmd_editor_list ;;
                set) cmd_editor_set "$@" ;;
                show) cmd_editor_show ;;
                test) cmd_editor_test ;;
                *)
                    error "Unknown editor command: $subcmd"
                    usage
                    exit 1
                    ;;
            esac
            ;;
        model)
            if [[ $# -eq 0 ]]; then
                cmd_model_show
                exit 0
            fi
            local subcmd="$1"
            shift
            case "$subcmd" in
                show) cmd_model_show ;;
                prefix)
                    if [[ $# -eq 0 ]]; then
                        error "Usage: set-config model prefix <value>"
                        echo "  Use '' for no prefix, 'cc/' for router, etc."
                        exit 1
                    fi
                    cmd_model_prefix "$1"
                    ;;
                *)
                    error "Unknown model command: $subcmd"
                    usage
                    exit 1
                    ;;
            esac
            ;;
        get) cmd_local_get "$@" ;;
        set) cmd_local_set "$@" ;;
        list) cmd_local_list "$@" ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "Unknown command: $command"
            usage
            exit 1
            ;;
    esac
}

main "$@"
