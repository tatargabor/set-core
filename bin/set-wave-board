#!/usr/bin/env python3
"""set-wave-board — the live execution status of a job that runs in waves.

Usage:
    set-wave-board init <job> --title T [--artifact-url URL]
    set-wave-board add <job> --wave <id> [--wave-title T] --item <id> --title T [--evidence JSON]
                       [--depends-on [PROJECT:]JOB/ITEM ...]
    set-wave-board set <job> <item> <todo|doing|done|blocked|skipped> [--note N] [--force]
    set-wave-board link <job> <artifact-url>
    set-wave-board share [<job>...]
    set-wave-board depend <job> <item> [PROJECT:]JOB/ITEM...
    set-wave-board undepend <job> <item> [PROJECT:]JOB/ITEM...
    set-wave-board overview
    set-wave-board combined-page [-o FILE] [--bare]
    set-wave-board combined-link <url>
    set-wave-board sync [<job>...]
    set-wave-board pushed <job> --version N [--hash H]
    set-wave-board pending
    set-wave-board stale [<job>...]
    set-wave-board reviewed <job>
    set-wave-board page
    set-wave-board render <job> [-o FILE] [--bare]

Common options (after the command): --repo DIR, --json, --quiet, -v.

WHAT A WAVE BOARD IS
    A process roadmap, not a product roadmap: which wave a multi-step job is in, which
    item is done, in progress or blocked, and what is left. One job is one tracked file,
    `docs/waveboard/<job>.json`, in the repository that runs the job.

THREE LAYERS, IN FALLING ORDER OF RELIABILITY
    1. the job file — waves, items, and the evidence that proves each item;
    2. `sync`, run by the Stop hook whether or not the agent remembered anything — it
       derives status from evidence;
    3. `set`, the agent's own report — the fast lane, overwritten wherever evidence speaks.

WHY THE SCRIPT DOES NOT PUSH
    The board is a claude.ai Artifact page whose live data is the Artifact's database,
    and only the agent can write that database (its ArtifactData tool). So `sync` writes
    the exact document body to `.set/waveboard/<job>.state.json` and prints a PUSH line;
    the agent sends that file as collection `board`, document `state`, and records the
    push with `pushed`. `set-hook-waveboard` makes sure it is not forgotten.

STALENESS — WHEN THE THIRD LAYER WAS FORGOTTEN
    An item with no evidence, and a blocked item, move only by `set`. A board is STALE when
    it has such items open and HEAD has at least SET_WAVEBOARD_STALE_COMMITS (default 3)
    commits newer than the board's last change (the newest item `updated` or `reviewed.at`).
    `stale` lists this; the Stop hook asks for a review of a stale board. When the items are
    checked and still right, `reviewed <job>` records it in the job file — it is not part of
    the pushed content, so it never causes a push.

SHARING — EVERY EDITOR CAN WRITE THE BOARD
    Only the account that published a page and the editors it was shared with can write its
    database. `init --artifact-url`, `link` and `share` print the share step from a
    machine-local editor list — SET_WAVEBOARD_EDITORS, default
    ~/.config/set-core/waveboard-editors.json, shaped
    {"owner_account": "...", "editors": ["...", ...]} — and say whether this session's
    claude.ai account (`.claude.json`) is the owner account. The list is never copied into a
    repository, a payload or a log. A push refused for lack of access is answered by asking
    the owner for edit access, not by switching the reminder off.

THE COMBINED BOARD — EVERY PROJECT'S BOARDS IN ONE SHARED PAGE
    Scope: only projects matching `projects` in the editor list (registry names or fnmatch
    patterns) go there, because the page is shared and a machine holds more projects than
    one team's; without `projects` nothing is pushed to it. `overview` follows the same
    scope unless --all.
    One more Artifact, published from the owner account and shared with the editors, whose
    database holds collection `boards`, one document per board (`<project>--<job>`). Its URL
    is `combined_url` in the editor list (`combined-link <url>` writes it; that is the
    tool's only write to the list). With it set, `sync` also writes the board's combined
    payload and prints PUSH-COMBINED; the Stop hook asks for that push too, and `pushed
    --combined` records it. `combined-page` renders the page with this machine's boards as
    its first frame.

DEPENDENCIES — AN ITEM MAY WAIT ON ANOTHER BOARD'S ITEM
    `depends_on: [{"project"?, "job", "item"}]`, written `[project:]job/item`; no project means
    this repository, a project is resolved by registry name. A dependency is met only when
    that item is `done` — `skipped` or unresolved is unmet. `sync` puts each open item's unmet
    references (`waiting_on`) and the items elsewhere that wait on it (`blocks`) into the
    payload, so both boards show the link. `set` refuses doing/done on a waiting item unless
    --force. `overview` lists every registered project's boards and their edges.

EVIDENCE (paths relative to the repository root; never absolute)
    {"type":"openspec-tasks","path":"openspec/changes/<x>/tasks.md"}
        all boxes checked = done, some = doing, none = todo; gone but archived = done
    {"type":"path-exists","path":"..."}          exists = done
    {"type":"commit","grep":"<pattern>"}         `git log --grep` on HEAD finds one = done
    {"type":"project","project":"<registry name>","evidence":{...}}
        the nested evidence, evaluated in another project resolved by its set-core
        registry name (SET_CORE_REGISTRY, default ~/.config/set-core/projects.json)

    Absence of evidence is NOT a verdict: a missing path, a missing tasks file with no
    archive, or no matching commit leaves the status as it is — absence cannot tell
    "not yet" from "not on this machine". Where evidence speaks it wins, except over a
    manual `blocked` or `skipped`, which are human decisions no evidence can see.

Exit status: 0 = ok, 1 = a job could not be processed, 2 = usage or input error.
"""
from __future__ import annotations

import argparse
import datetime as _dt
import fnmatch
import hashlib
import html
import json
import logging
import os
import re
import socket
import subprocess
import sys
from pathlib import Path

logger = logging.getLogger("set-wave-board")

SCHEMA = "set-wave-board/1"
STATUSES = ("todo", "doing", "done", "blocked", "skipped")
STICKY = ("blocked", "skipped")
EVIDENCE_FIELDS = {
    "openspec-tasks": ("path",),
    "path-exists": ("path",),
    "commit": ("grep",),
    "project": ("project", "evidence"),
}
JOB_DIR = Path("docs") / "waveboard"
STATE_DIR = Path(".set") / "waveboard"
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
BOX_RE = re.compile(r"^\s*[-*]\s+\[([ xX])\]")
SEED_MARKER = '<script type="application/json" id="seed">null</script>'
GIT_TIMEOUT = 20


class UsageError(Exception):
    """Bad input from the caller — exit 2, nothing written."""


# ── small helpers ────────────────────────────────────────────────────────────

def now_iso() -> str:
    return _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def host_label() -> str:
    override = os.environ.get("SET_WAVEBOARD_BY", "").strip()
    if override:
        return override
    return (socket.gethostname() or "unknown").split(".")[0]


def dump(obj) -> str:
    return json.dumps(obj, indent=2, ensure_ascii=False) + "\n"


def write_if_changed(path: Path, text: str) -> bool:
    """Atomic write, skipped when the bytes are already there. Returns True if written."""
    try:
        if path.read_text(encoding="utf-8") == text:
            return False
    except FileNotFoundError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)
    logger.debug("wrote %s", path)
    return True


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        logger.warning("unreadable %s: %s", path, e)
        return None


def git(args, cwd: Path):
    try:
        return subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True,
                              timeout=GIT_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        logger.warning("git %s failed in %s: %s", args[0], cwd, e)
        return None


def repo_root(start: str) -> Path:
    r = git(["rev-parse", "--show-toplevel"], Path(start))
    if r is None or r.returncode != 0 or not r.stdout.strip():
        raise UsageError(f"not inside a git repository: {start}")
    return Path(r.stdout.strip())


def registry_path() -> Path:
    env = os.environ.get("SET_CORE_REGISTRY", "").strip()
    if env:
        return Path(env).expanduser()
    return Path.home() / ".config" / "set-core" / "projects.json"


def resolve_project(name: str):
    reg = read_json(registry_path())
    if not isinstance(reg, dict):
        return None
    entry = (reg.get("projects") or {}).get(name)
    if not isinstance(entry, dict) or not entry.get("path"):
        return None
    return Path(entry["path"]).expanduser()


def check_id(kind: str, value: str) -> str:
    if not ID_RE.match(value or ""):
        raise UsageError(f"invalid {kind} id {value!r}: letters, digits, . _ - (max 64)")
    return value


def check_rel_path(value) -> str:
    if not isinstance(value, str) or not value.strip():
        raise UsageError("evidence path must be a non-empty string")
    if (value.startswith(("/", "~", "\\")) or re.match(r"^[A-Za-z]:[\\/]", value)
            or ".." in Path(value).parts):
        raise UsageError(f"evidence path must be relative to the repository root: {value!r}")
    return value


def validate_evidence(ev, nested: bool = False) -> dict:
    if not isinstance(ev, dict):
        raise UsageError("evidence must be a JSON object")
    kind = ev.get("type")
    if kind not in EVIDENCE_FIELDS:
        raise UsageError(f"unknown evidence type {kind!r}; known: {', '.join(EVIDENCE_FIELDS)}")
    for field in EVIDENCE_FIELDS[kind]:
        if field not in ev:
            raise UsageError(f"evidence type {kind!r} needs {field!r}")
    if kind in ("openspec-tasks", "path-exists"):
        check_rel_path(ev["path"])
    elif kind == "commit":
        if not isinstance(ev["grep"], str) or not ev["grep"].strip():
            raise UsageError("commit evidence needs a non-empty 'grep' pattern")
    elif kind == "project":
        if nested:
            raise UsageError("project evidence cannot be nested inside project evidence")
        if not isinstance(ev["project"], str) or not ev["project"].strip():
            raise UsageError("project evidence needs a registry name in 'project'")
        validate_evidence(ev["evidence"], nested=True)
    return ev


# ── sharing (change `wave-board-shared-linked`, D1–D2) ───────────────────────
#
# A board's page can be written only by the account that published it and by the editors it
# was shared with. The editor list is machine-local because it holds addresses: it is read
# here and printed to the terminal, and never copied into the job file, the payload or a log.

EDITORS_SHAPE = '{"owner_account": "<account email>", "editors": ["<email>", ...]}'


def editors_path() -> Path:
    env = os.environ.get("SET_WAVEBOARD_EDITORS", "").strip()
    if env:
        return Path(env).expanduser()
    return Path.home() / ".config" / "set-core" / "waveboard-editors.json"


def load_editors():
    """(list or None, reason or None). A missing or malformed list is a reason, not an error."""
    p = editors_path()
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None, f"no editor list at {p}"
    except (OSError, ValueError) as e:
        logger.warning("editor list %s is unreadable: %s", p, type(e).__name__)
        return None, f"the editor list at {p} is unreadable ({type(e).__name__})"
    owner = data.get("owner_account") if isinstance(data, dict) else None
    editors = data.get("editors") if isinstance(data, dict) else None
    if not isinstance(owner, str) or not owner.strip() or not isinstance(editors, list) \
            or not all(isinstance(e, str) and e.strip() for e in editors):
        logger.warning("editor list %s does not have the expected shape", p)
        return None, f"the editor list at {p} does not have the shape {EDITORS_SHAPE}"
    logger.debug("editor list: %d editor(s)", len(editors))
    combined = data.get("combined_url")
    if combined is not None and not (isinstance(combined, str) and re.match(r"^https://\S+$", combined)):
        logger.warning("editor list %s: combined_url is not an https URL; ignored", p)
        combined = None
    scope = data.get("projects")
    if scope is not None and not (isinstance(scope, list) and all(isinstance(x, str) and x.strip() for x in scope)):
        logger.warning("editor list %s: projects is not a list of names or patterns; ignored", p)
        scope = None
    return {"owner_account": owner.strip(), "editors": [e.strip() for e in editors],
            "combined_url": combined, "projects": [x.strip() for x in scope] if scope else None}, None


def team_scope():
    """The registry names (fnmatch patterns) whose boards belong to the team's combined board.

    None when the list sets none. The combined board is shared with other people, so a board
    outside the scope never goes there — a machine holds more projects than one team's.
    """
    lst, _ = load_editors()
    return lst.get("projects") if lst else None


def in_scope(name: str, scope) -> bool:
    return bool(scope) and any(fnmatch.fnmatchcase(name, pat) for pat in scope)


def scoped_name(root: Path):
    """This repository's registry name inside the team scope, or None."""
    scope = team_scope()
    return next((n for n in sorted(names_of(root)) if in_scope(n, scope)), None)


def combined_url():
    lst, _ = load_editors()
    return lst.get("combined_url") if lst else None


def project_name(root: Path) -> str:
    """This repository's name on the combined board: its registry name, else its folder."""
    names = sorted(names_of(root))
    return names[0] if names else Path(os.path.realpath(root)).name


def combined_doc_id(project: str, job: str) -> str:
    return f"{project}--{job}"


def session_account():
    """The claude.ai account this session publishes as, or None when it cannot be read."""
    base = os.environ.get("CLAUDE_CONFIG_DIR", "").strip()
    p = Path(base).expanduser() / ".claude.json" if base else Path.home() / ".claude.json"
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    acct = (data.get("oauthAccount") or {}).get("emailAddress") if isinstance(data, dict) else None
    return acct.strip() if isinstance(acct, str) and acct.strip() else None


def share_info(url) -> dict:
    lst, reason = load_editors()
    acct = session_account()
    owner = lst["owner_account"] if lst else None
    matches = None if (owner is None or acct is None) else acct.lower() == owner.lower()
    return {"url": url, "editor_list": str(editors_path()), "editor_list_reason": reason,
            "owner_account": owner, "editors": lst["editors"] if lst else [],
            "session_account": acct, "session_is_owner": matches}


def share_lines(job: str, info: dict) -> list:
    owner, acct = info["owner_account"], info["session_account"] or "unknown"
    if not info["url"]:
        who = f"the owner account {owner}" if owner else "the account that will own it"
        return [f"UNPUBLISHED {job}: publish the board page from {who}, then run "
                f"`set-wave-board link {job} <url>`; this session: {acct}"]
    if info["editor_list_reason"]:
        return [f"SHARE {job} {info['url']}: {info['editor_list_reason']}; create it as "
                f"{EDITORS_SHAPE} so this step can name who gets edit access",
                f"  this session: {acct}"]
    editors = ", ".join(info["editors"]) or "(the list names no editors)"
    if info["session_is_owner"] is True:
        verdict = "the owner account"
    elif info["session_is_owner"] is False:
        verdict = f"NOT the owner account: publish and share the board from {owner}"
    else:
        verdict = "not known whether it is the owner account"
    return [f"SHARE {job} {info['url']}: on claude.ai open the board, Share, and invite with "
            f"edit access: {editors}",
            f"  owner account: {owner} · this session: {acct} ({verdict})"]


# ── dependencies (change `wave-board-shared-linked`, D3–D6) ──────────────────
#
# An item may wait on another board's item. A dependency says when an item may START; evidence
# says when it is DONE — so it is a field, not an evidence type. Met means `done` and nothing
# else; a reference that cannot be resolved is unmet, because releasing work on a reference
# nobody can read is the failure nobody would see.

REF_RE = re.compile(r"^(?:([A-Za-z0-9][A-Za-z0-9._-]{0,127}):)?"
                    r"([A-Za-z0-9][A-Za-z0-9._-]{0,63})/([A-Za-z0-9][A-Za-z0-9._-]{0,63})$")


def parse_ref(text: str) -> dict:
    m = REF_RE.match((text or "").strip())
    if not m:
        raise UsageError(f"invalid dependency {text!r}: expected [project:]job/item")
    ref = {"job": m.group(2), "item": m.group(3)}
    if m.group(1):
        ref = {"project": m.group(1), **ref}
    return ref


def ref_key(ref: dict):
    return (ref.get("project") or None, ref.get("job"), ref.get("item"))


def ref_str(ref: dict) -> str:
    p = ref.get("project")
    return (f"{p}:" if p else "") + f"{ref.get('job')}/{ref.get('item')}"


def valid_ref(ref) -> bool:
    if not isinstance(ref, dict) or set(ref) - {"project", "job", "item"}:
        return False
    if not all(isinstance(ref.get(k), str) and ID_RE.match(ref[k]) for k in ("job", "item")):
        return False
    p = ref.get("project")
    return p is None or (isinstance(p, str) and bool(re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", p)))


def registry_entries():
    """[(name, realpath)] of every registered project whose path is a string."""
    reg = read_json(registry_path())
    projects = (reg.get("projects") or {}) if isinstance(reg, dict) else {}
    res = []
    for name, entry in projects.items():
        if isinstance(entry, dict) and isinstance(entry.get("path"), str):
            res.append((name, os.path.realpath(os.path.expanduser(entry["path"]))))
    return res


def names_of(root: Path) -> set:
    """Every registry name that resolves to this repository."""
    real = os.path.realpath(root)
    return {name for name, path in registry_entries() if path == real}


_BOARDS: dict = {}


def board_data(root: Path, job: str):
    """(job data or None, reason or None) for another board, cached for this process."""
    key = (os.path.realpath(root), job)
    if key not in _BOARDS:
        p = job_path(root, job)
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
        except FileNotFoundError:
            _BOARDS[key] = (None, f"no board {job!r} there")
        except (OSError, ValueError) as e:
            _BOARDS[key] = (None, f"board {job!r} is unreadable ({type(e).__name__})")
        else:
            if not isinstance(data, dict) or data.get("schema") != SCHEMA:
                _BOARDS[key] = (None, f"board {job!r} is not a {SCHEMA} file")
            else:
                _BOARDS[key] = (data, None)
    return _BOARDS[key]


def forget_boards() -> None:
    _BOARDS.clear()


def resolve_ref(ref: dict, here: Path) -> dict:
    """{status, met, reason} of one reference, seen from the repository `here`."""
    if not valid_ref(ref):
        return {"status": None, "met": False, "reason": "malformed reference"}
    project = ref.get("project")
    if project:
        root = resolve_project(project)
        if root is None:
            return {"status": None, "met": False,
                    "reason": f"project {project!r} is not registered on this machine"}
        if not root.is_dir():
            return {"status": None, "met": False,
                    "reason": f"project {project!r} is registered but its directory is missing"}
    else:
        root = here
    data, reason = board_data(root, ref["job"])
    if data is None:
        return {"status": None, "met": False, "reason": reason}
    _, item = find_item({"waves": data.get("waves") or []}, ref["item"])
    if item is None:
        return {"status": None, "met": False, "reason": f"no item {ref['item']!r} on board {ref['job']!r}"}
    status = item.get("status")
    return {"status": status, "met": status == "done", "reason": None}


def unmet(item: dict, here: Path) -> list:
    res = []
    for ref in item.get("depends_on") or []:
        r = resolve_ref(ref, here)
        if not r["met"]:
            res.append({**(ref if isinstance(ref, dict) else {}), "status": r["status"],
                        "reason": r["reason"]})
    return res


def _iter_items(data: dict):
    for wave in data.get("waves") or []:
        if isinstance(wave, dict):
            for item in wave.get("items") or []:
                if isinstance(item, dict):
                    yield item


def blocks_index(here: Path) -> dict:
    """{(job, item): [{project?, job, item, status}]} — who waits on items of this repository.

    Scans this repository and every registered project's `docs/waveboard/*.json`; no git.
    """
    real = os.path.realpath(here)
    mine = names_of(here)
    repos = [(None, Path(real))]
    seen = {real}
    for name, path in registry_entries():
        if path not in seen and os.path.isdir(path):
            seen.add(path)
            repos.append((name, Path(path)))
    index: dict = {}
    for name, root in repos:
        d = root / JOB_DIR
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.json")):
            data, _ = board_data(root, p.stem)
            if data is None:
                continue
            for item in _iter_items(data):
                for ref in item.get("depends_on") or []:
                    if not valid_ref(ref):
                        continue
                    target = ref.get("project")
                    points_here = (target in mine) if name else (target is None or target in mine)
                    if not points_here:
                        continue
                    by = {"job": p.stem, "item": item.get("id"), "status": item.get("status")}
                    if name:
                        by = {"project": name, **by}
                    index.setdefault((ref["job"], ref["item"]), []).append(by)
    return index


def dependency_view(root: Path, job: str, data: dict) -> dict:
    """{item id: {"waiting_on": [...], "blocks": [...]}} — only non-empty lists."""
    index = blocks_index(root)
    view = {}
    for item in _iter_items(data):
        entry = {}
        if item.get("status") not in ("done", "skipped"):
            waiting = unmet(item, root)
            if waiting:
                entry["waiting_on"] = waiting
        blocks = index.get((job, item.get("id")))
        if blocks:
            entry["blocks"] = blocks
        if entry:
            view[item.get("id")] = entry
    return view


# ── evidence ─────────────────────────────────────────────────────────────────

def _tasks_status(path: Path):
    total = checked = 0
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        m = BOX_RE.match(line)
        if m:
            total += 1
            checked += m.group(1) in "xX"
    if total and checked == total:
        return "done"
    return "doing" if checked else "todo"


def evaluate(ev: dict, base: Path):
    """Return (status or None, unresolved reason or None). None status = no verdict."""
    kind = ev.get("type")
    if kind == "openspec-tasks":
        p = base / ev["path"]
        if p.is_file():
            return _tasks_status(p), None
        # openspec/changes/<x>/tasks.md, archived as openspec/changes/archive/<date>-<x>/tasks.md
        rel = Path(ev["path"])
        change = rel.parent
        archive = base / change.parent / "archive"
        if change.name and archive.is_dir():
            for d in sorted(archive.iterdir()):
                if d.name.endswith("-" + change.name) and (d / rel.name).is_file():
                    logger.debug("archived tasks for %s found at %s", ev["path"], d)
                    return "done", None
        return None, None
    if kind == "path-exists":
        return ("done" if (base / ev["path"]).exists() else None), None
    if kind == "commit":
        r = git(["log", "-1", "--format=%H", f"--grep={ev['grep']}", "HEAD"], base)
        if r is not None and r.returncode == 0 and r.stdout.strip():
            return "done", None
        return None, None
    if kind == "project":
        root = resolve_project(ev["project"])
        if root is None:
            return None, f"project {ev['project']!r} is not registered on this machine"
        if not root.is_dir():
            return None, f"project {ev['project']!r} is registered but its directory is missing"
        return evaluate(ev["evidence"], root)
    return None, f"unknown evidence type {kind!r}"


# ── the job file ─────────────────────────────────────────────────────────────

def job_path(root: Path, job: str) -> Path:
    return root / JOB_DIR / f"{job}.json"


def state_dir(root: Path) -> Path:
    d = root / STATE_DIR
    d.mkdir(parents=True, exist_ok=True)
    # Machine-local state never shows up as untracked, whatever the project's own
    # ignore file says (`.set/` is ignored in set-core consumers, but not everywhere).
    write_if_changed(d / ".gitignore", "*\n")
    return d


def load_job(root: Path, job: str) -> dict:
    check_id("job", job)
    p = job_path(root, job)
    data = read_json(p)
    if data is None:
        raise UsageError(f"no such job (or unreadable): {p}")
    if not isinstance(data, dict) or data.get("schema") != SCHEMA:
        raise UsageError(f"{p} is not a {SCHEMA} file")
    data.setdefault("waves", [])
    return data


def save_job(root: Path, job: str, data: dict) -> bool:
    written = write_if_changed(job_path(root, job), dump(data))
    if written:
        forget_boards()  # a dependency read later in this process must see the new status
    return written


def find_item(data: dict, item_id: str):
    for wave in data["waves"]:
        for item in wave.get("items", []):
            if item.get("id") == item_id:
                return wave, item
    return None, None


def all_jobs(root: Path):
    d = root / JOB_DIR
    if not d.is_dir():
        return []
    return sorted(p.stem for p in d.glob("*.json"))


def content_of(data: dict, deps=None) -> dict:
    """The pushed content. `deps` adds the computed `waiting_on` / `blocks` per item; an item
    without either is left exactly as it is, so a board without dependencies hashes as before."""
    waves = data["waves"]
    if deps:
        waves = [dict(w, items=[dict(it, **deps.get(it.get("id"), {})) for it in w.get("items", [])])
                 for w in waves]
    return {"schema": SCHEMA, "job": data["job"], "title": data.get("title", ""),
            "waves": waves}


def content_hash(content: dict) -> str:
    canon = json.dumps(content, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(canon.encode("utf-8")).hexdigest()


# ── sync ─────────────────────────────────────────────────────────────────────

def sync_job(root: Path, job: str) -> dict:
    data = load_job(root, job)
    if data.get("job") != job:
        logger.warning("job file %s names job %r; using the file name", job_path(root, job),
                       data.get("job"))
        data["job"] = job
    unresolved, changed_items = [], []
    stamp, who = now_iso(), host_label()
    for wave in data["waves"]:
        for item in wave.get("items", []):
            ev = item.get("evidence")
            if not ev:
                continue
            status, reason = evaluate(ev, root)
            if reason:
                unresolved.append({"item": item.get("id"), "reason": reason})
                logger.warning("UNRESOLVED %s/%s: %s", job, item.get("id"), reason)
            if status is None or item.get("status") in STICKY or item.get("status") == status:
                continue
            logger.info("%s/%s: %s -> %s (evidence)", job, item.get("id"), item.get("status"), status)
            changed_items.append({"item": item.get("id"), "old": item.get("status"), "new": status})
            item["status"], item["updated"], item["by"] = status, stamp, who
    file_changed = save_job(root, job, data)

    content = content_of(data, dependency_view(root, job, data))
    h = content_hash(content)
    sdir = state_dir(root)
    payload = sdir / f"{job}.state.json"
    old = read_json(payload)
    state_changed = False
    if not isinstance(old, dict) or old.get("content_hash") != h:
        state = dict(content, synced_at=stamp, synced_by=who, content_hash=h)
        state_changed = write_if_changed(payload, dump(state))
    pushed = read_json(sdir / f"{job}.pushed.json") or {}
    url = data.get("artifact_url")

    # The combined board (change `wave-board-shared-linked`, round 2): one document per
    # board in the combined Artifact's `boards` collection, keyed <project>--<job>.
    curl = combined_url()
    project = scoped_name(root) if curl else None
    combined = {"combined_url": curl if project else None, "combined_doc": None, "combined_payload": None,
                "combined_hash": None, "combined_pushed_version": None, "combined_push_needed": False}
    if curl and project is None:
        logger.debug("%s: not in the team scope; no combined push", job)
    if curl and project:
        doc = combined_doc_id(project, job)
        body = dict(content, project=project, artifact_url=url)
        ch = content_hash(body)
        cpath = sdir / f"{job}.combined.json"
        cold = read_json(cpath)
        if not isinstance(cold, dict) or cold.get("content_hash") != ch:
            write_if_changed(cpath, dump(dict(body, synced_at=stamp, synced_by=who, content_hash=ch)))
        cpushed = read_json(sdir / f"{job}.combined-pushed.json") or {}
        same_target = cpushed.get("url") == curl
        combined.update(combined_doc=doc, combined_payload=str(cpath), combined_hash=ch,
                        combined_pushed_version=cpushed.get("version") if same_target else None,
                        combined_push_needed=not same_target or cpushed.get("hash") != ch)
    return {
        **combined,
        "job": job,
        "artifact_url": url,
        "payload": str(payload),
        "content_hash": h,
        "file_changed": file_changed,
        "state_changed": state_changed,
        "changed_items": changed_items,
        "unresolved": unresolved,
        "pushed_version": pushed.get("version"),
        "push_needed": bool(url) and pushed.get("hash") != h,
    }


# ── staleness ────────────────────────────────────────────────────────────────
#
# Sync cannot move an item without evidence, nor a blocked one, so only an agent's `set`
# moves those — and nothing used to ask for it. A board is stale when such items are open
# and the repository has moved on since the board last changed. The same rule is written
# in `lib/set_orch/fleet/waveboards.py` (this script does not import set_orch); a test holds
# the two together. See openspec change `wave-board-staleness`, D1–D4.

DEFAULT_STALE_COMMITS = 3


def stale_threshold() -> int:
    raw = os.environ.get("SET_WAVEBOARD_STALE_COMMITS", "").strip()
    try:
        return max(1, int(raw)) if raw else DEFAULT_STALE_COMMITS
    except ValueError:
        logger.warning("SET_WAVEBOARD_STALE_COMMITS=%r is not a number; using %d", raw,
                       DEFAULT_STALE_COMMITS)
        return DEFAULT_STALE_COMMITS


def _parse_time(value):
    """An ISO timestamp or date as an aware UTC datetime, or None."""
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        t = _dt.datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return t.replace(tzinfo=_dt.timezone.utc) if t.tzinfo is None else t.astimezone(_dt.timezone.utc)


def manual_open(data: dict) -> list:
    """Open items sync cannot move: no evidence, or blocked (sticky)."""
    res = []
    for wave in data.get("waves") or []:
        if not isinstance(wave, dict):
            continue
        for item in wave.get("items") or []:
            if not isinstance(item, dict):
                continue
            status = item.get("status")
            if status in ("done", "skipped"):
                continue
            if not item.get("evidence") or status == "blocked":
                res.append({"id": item.get("id"), "status": status, "title": item.get("title", ""),
                            "wave": wave.get("id")})
    return res


def last_change(data: dict):
    """Newest item `updated` or `reviewed.at`; failing both, `created`. None if nothing parses."""
    times = [_parse_time(item.get("updated"))
             for wave in data.get("waves") or [] if isinstance(wave, dict)
             for item in wave.get("items") or [] if isinstance(item, dict)]
    reviewed = data.get("reviewed")
    if isinstance(reviewed, dict):
        times.append(_parse_time(reviewed.get("at")))
    times = [t for t in times if t is not None]
    if not times:
        created = _parse_time(data.get("created"))
        return created
    return max(times)


def commits_since(root: Path, since):
    """Commits on HEAD strictly newer than `since`, or None when it cannot be counted."""
    if since is None:
        return None
    after = (since + _dt.timedelta(seconds=1)).strftime("%Y-%m-%d %H:%M:%S +0000")
    r = git(["rev-list", "--count", f"--since={after}", "HEAD"], root)
    if r is None or r.returncode != 0:
        logger.debug("cannot count commits in %s: %s", root, r.stderr.strip() if r else "git failed")
        return None
    try:
        return int(r.stdout.strip())
    except ValueError:
        return None


def staleness(root: Path, job: str, data: dict) -> dict:
    manual = manual_open(data)
    since = last_change(data)
    count = commits_since(root, since)
    return {
        "job": job,
        "last_change": since.strftime("%Y-%m-%dT%H:%M:%SZ") if since else None,
        "commits_since_change": count,
        "manual_open": manual,
        "stale": bool(manual) and count is not None and count >= stale_threshold(),
    }


# ── commands ─────────────────────────────────────────────────────────────────

def out(args, obj, text_lines):
    if args.json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))
    elif not args.quiet:
        for line in text_lines:
            print(line)


def push_line(r: dict) -> str:
    return f"PUSH {r['job']} {r['artifact_url']} {r['payload']}"


def push_lines(r: dict) -> list:
    lines = [push_line(r)] if r.get("push_needed") else []
    if r.get("combined_push_needed"):
        lines.append(f"PUSH-COMBINED {r['job']} {r['combined_url']} boards/{r['combined_doc']} "
                     f"{r['combined_payload']}")
    return lines


def cmd_init(args, root):
    job = check_id("job", args.job)
    p = job_path(root, job)
    if p.exists():
        raise UsageError(f"job already exists: {p}")
    if args.artifact_url:
        check_url(args.artifact_url)
    data = {"schema": SCHEMA, "job": job, "title": args.title,
            "artifact_url": args.artifact_url or None,
            "created": _dt.date.today().isoformat(), "waves": []}
    save_job(root, job, data)
    logger.info("created %s", p)
    info = share_info(data["artifact_url"])
    out(args, {"job": job, "file": str(p), "share": info}, [str(p)] + share_lines(job, info))
    return 0


def cmd_add(args, root):
    data = load_job(root, args.job)
    wave_id, item_id = check_id("wave", args.wave), check_id("item", args.item)
    ev = None
    if args.evidence:
        try:
            ev = json.loads(args.evidence)
        except ValueError as e:
            raise UsageError(f"--evidence is not valid JSON: {e}")
        validate_evidence(ev)
    deps = []
    for text in args.depends_on or []:
        ref = parse_ref(text)
        check_not_self(root, args.job, item_id, ref)
        if ref not in deps:
            deps.append(ref)
    if find_item(data, item_id)[1] is not None:
        raise UsageError(f"item {item_id!r} already exists in job {args.job!r}")
    wave = next((w for w in data["waves"] if w.get("id") == wave_id), None)
    if wave is None:
        wave = {"id": wave_id, "title": args.wave_title or wave_id, "items": []}
        data["waves"].append(wave)
    elif args.wave_title:
        wave["title"] = args.wave_title
    new_item = {"id": item_id, "title": args.title, "status": "todo", "evidence": ev,
                "note": "", "updated": now_iso(), "by": host_label()}
    if deps:
        new_item["depends_on"] = deps
    wave.setdefault("items", []).append(new_item)
    save_job(root, args.job, data)
    logger.info("added %s/%s to wave %s", args.job, item_id, wave_id)
    out(args, {"job": args.job, "wave": wave_id, "item": item_id}, [f"added {args.job}/{item_id}"])
    return 0


def cmd_set(args, root):
    if args.status not in STATUSES:
        raise UsageError(f"status must be one of {', '.join(STATUSES)}")
    data = load_job(root, args.job)
    _, item = find_item(data, args.item)
    if item is None:
        raise UsageError(f"no item {args.item!r} in job {args.job!r}")
    old = item.get("status")
    if args.status in ("doing", "done") and old != args.status:
        waiting = unmet(item, root)
        if waiting and not args.force:
            raise UsageError(
                f"{args.job}/{args.item} waits on " + "; ".join(
                    f"{ref_str(w)} ({w['status'] or w['reason']})" for w in waiting)
                + f" — it cannot be set {args.status} until those are done (--force overrides)")
        if waiting:
            logger.warning("%s/%s set %s with %d unmet dependenc(ies) (--force)", args.job,
                           args.item, args.status, len(waiting))
    if old != args.status or (args.note is not None and args.note != item.get("note")):
        item["status"] = args.status
        if args.note is not None:
            item["note"] = args.note
        item["updated"], item["by"] = now_iso(), host_label()
        save_job(root, args.job, data)
        logger.info("%s/%s: %s -> %s (manual)", args.job, args.item, old, args.status)
    # Evidence is evaluated straight away, so a report the evidence contradicts is
    # corrected — and said — now, not at the next Stop.
    r = sync_job(root, args.job)
    final = find_item(load_job(root, args.job), args.item)[1].get("status")
    if final != args.status:
        logger.warning("%s/%s: evidence says %s, not %s", args.job, args.item, final, args.status)
    lines = [f"{args.job}/{args.item}: {final}"] + push_lines(r)
    out(args, dict(r, item=args.item, status=final), lines)
    return 0


def check_url(url: str) -> str:
    if not re.match(r"^https://\S+$", url or ""):
        raise UsageError(f"artifact url must be an https URL: {url!r}")
    return url


def cmd_link(args, root):
    data = load_job(root, args.job)
    data["artifact_url"] = check_url(args.url)
    save_job(root, args.job, data)
    info = share_info(args.url)
    out(args, {"job": args.job, "artifact_url": args.url, "share": info},
        [f"{args.job} -> {args.url}"] + share_lines(args.job, info))
    return 0


def cmd_share(args, root):
    jobs = args.jobs or all_jobs(root)
    results, lines, rc = [], [], 0
    for job in jobs:
        try:
            data = load_job(root, job)
        except UsageError as e:
            logger.error("%s: %s", job, e)
            rc = 1
            continue
        info = share_info(data.get("artifact_url"))
        results.append({"job": job, "share": info})
        lines += share_lines(job, info)
    out(args, results, lines)
    return rc


def check_not_self(root: Path, job: str, item: str, ref: dict) -> None:
    if ref["job"] == job and ref["item"] == item and (
            not ref.get("project") or ref["project"] in names_of(root)):
        raise UsageError(f"{job}/{item} cannot depend on itself")


def cmd_depend(args, root, remove=False):
    data = load_job(root, args.job)
    _, item = find_item(data, args.item)
    if item is None:
        raise UsageError(f"no item {args.item!r} in job {args.job!r}")
    refs = [parse_ref(t) for t in args.refs]
    deps = [d for d in (item.get("depends_on") or []) if isinstance(d, dict)]
    before = list(deps)
    for ref in refs:
        if remove:
            deps = [d for d in deps if ref_key(d) != ref_key(ref)]
        else:
            check_not_self(root, args.job, args.item, ref)
            if all(ref_key(d) != ref_key(ref) for d in deps):
                deps.append(ref)
    if deps != before:
        if deps:
            item["depends_on"] = deps
        else:
            item.pop("depends_on", None)
        item["updated"], item["by"] = now_iso(), host_label()
        save_job(root, args.job, data)
        logger.info("%s/%s: %d -> %d dependenc(ies)", args.job, args.item, len(before), len(deps))
    shown = [dict(d, **resolve_ref(d, root)) for d in deps]
    lines = [f"{args.job}/{args.item} depends on: " + (", ".join(
        f"{ref_str(d)} ({'met' if d['met'] else (d['status'] or d['reason'])})" for d in shown) or "nothing")]
    out(args, {"job": args.job, "item": args.item, "depends_on": shown}, lines)
    return 0


def cmd_undepend(args, root):
    return cmd_depend(args, root, remove=True)


def cmd_overview(args, root):
    """Every registered project's boards and the edges between them (design D10)."""
    scope = None if args.all else team_scope()
    repos, seen = [], set()
    for name, path in registry_entries():
        if path not in seen and os.path.isdir(path) and (scope is None or in_scope(name, scope)):
            seen.add(path)
            repos.append((name, Path(path)))
    boards, edges = [], []
    incoming: dict = {}
    for name, proot in repos:
        d = proot / JOB_DIR
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.json")):
            data, reason = board_data(proot, p.stem)
            if data is None:
                boards.append({"project": name, "job": p.stem, "unreadable": True, "reason": reason})
                continue
            counts = {st: 0 for st in STATUSES}
            waiting = 0
            for item in _iter_items(data):
                if item.get("status") in counts:
                    counts[item["status"]] += 1
                open_item = item.get("status") not in ("done", "skipped")
                item_waits = False
                for ref in item.get("depends_on") or []:
                    r = resolve_ref(ref, proot) if isinstance(ref, dict) else \
                        {"status": None, "met": False, "reason": "malformed reference"}
                    target = {"project": (ref.get("project") if isinstance(ref, dict) else None) or name,
                              "job": ref.get("job") if isinstance(ref, dict) else None,
                              "item": ref.get("item") if isinstance(ref, dict) else None}
                    edges.append({"from": {"project": name, "job": p.stem, "item": item.get("id")},
                                  "to": target, **r})
                    incoming[(target["project"], target["job"], target["item"])] = \
                        incoming.get((target["project"], target["job"], target["item"]), 0) + (0 if r["met"] else 1)
                    item_waits = item_waits or (open_item and not r["met"])
                waiting += item_waits
            boards.append({"project": name, "job": p.stem, "title": data.get("title", ""),
                           "counts": counts, "waiting": waiting, "unreadable": False})
    for b in boards:
        if not b["unreadable"]:
            b["blocks"] = sum(n for (pr, jb, _), n in incoming.items() if pr == b["project"] and jb == b["job"])
    lines = []
    for b in boards:
        if b["unreadable"]:
            lines.append(f"UNREADABLE {b['project']}/{b['job']}: {b['reason']}")
            continue
        c = b["counts"]
        total = sum(c.values())
        lines.append(f"{b['project']}/{b['job']}: {c['done']}/{total - c['skipped']} done, "
                     f"{c['blocked']} blocked, {b['waiting']} waiting, blocks {b['blocks']}")
    for e in edges:
        f, t = e["from"], e["to"]
        lines.append(f"  {f['project']}/{f['job']}/{f['item']} -> {t['project']}/{t['job']}/{t['item']}: "
                     + ("met" if e["met"] else f"unmet ({e['status'] or e['reason']})"))
    out(args, {"boards": boards, "edges": edges}, lines)
    return 0


def cmd_sync(args, root):
    jobs = args.jobs or all_jobs(root)
    results, rc = [], 0
    for job in jobs:
        try:
            results.append(sync_job(root, job))
        except UsageError as e:
            logger.error("%s: %s", job, e)
            rc = 1
    out(args, results, [line for r in results for line in push_lines(r)])
    return rc


def cmd_stale(args, root):
    jobs = args.jobs or all_jobs(root)
    results, rc = [], 0
    for job in jobs:
        try:
            results.append(staleness(root, job, load_job(root, job)))
        except UsageError as e:
            logger.error("%s: %s", job, e)
            rc = 1
    lines = []
    for r in results:
        count = "not measured" if r["commits_since_change"] is None else f"{r['commits_since_change']} commit(s)"
        lines.append(f"{'STALE' if r['stale'] else 'ok   '} {r['job']}: {count} since "
                     f"{r['last_change'] or 'an unknown time'}, {len(r['manual_open'])} item(s) only an "
                     "agent can move")
    out(args, results, lines)
    return rc


def cmd_reviewed(args, root):
    data = load_job(root, args.job)
    old = data.get("reviewed")
    data["reviewed"] = {"at": now_iso(), "by": host_label()}
    save_job(root, args.job, data)
    logger.info("%s: reviewed (was %s)", args.job, old)
    out(args, dict(data["reviewed"], job=args.job), [f"{args.job}: reviewed at {data['reviewed']['at']}"])
    return 0


def pending_jobs(root: Path):
    res = []
    for job in all_jobs(root):
        try:
            data = load_job(root, job)
        except UsageError as e:
            logger.error("%s: %s", job, e)
            continue
        url = data.get("artifact_url")
        sdir = root / STATE_DIR
        curl = combined_url()
        cproject = scoped_name(root) if curl else None
        if curl and cproject:
            cstate = read_json(sdir / f"{job}.combined.json") or {}
            cpushed = read_json(sdir / f"{job}.combined-pushed.json") or {}
            same = cpushed.get("url") == curl
            if not cstate.get("content_hash") or not same or cstate.get("content_hash") != cpushed.get("hash"):
                res.append({"job": job, "target": "combined", "artifact_url": curl,
                            "doc_id": combined_doc_id(cproject, job),
                            "payload": str(sdir / f"{job}.combined.json"),
                            "synced": bool(cstate.get("content_hash")),
                            "content_hash": cstate.get("content_hash"),
                            "pushed_version": cpushed.get("version") if same else None})
        if not url:
            continue
        state = read_json(sdir / f"{job}.state.json") or {}
        pushed = read_json(sdir / f"{job}.pushed.json") or {}
        if not state.get("content_hash") or state.get("content_hash") != pushed.get("hash"):
            res.append({"job": job, "target": "board", "artifact_url": url, "doc_id": "state",
                        "payload": str(sdir / f"{job}.state.json"),
                        "synced": bool(state.get("content_hash")),
                        "content_hash": state.get("content_hash"),
                        "pushed_version": pushed.get("version")})
    return res


def cmd_pending(args, root):
    res = pending_jobs(root)
    lines = []
    for r in res:
        extra = f" if_version={r['pushed_version']}" if r["pushed_version"] else ""
        kind = "PENDING-COMBINED" if r["target"] == "combined" else "PENDING"
        where = f" boards/{r['doc_id']}" if r["target"] == "combined" else ""
        lines.append(f"{kind} {r['job']} {r['artifact_url']}{where} {r['payload']}{extra}"
                     + ("" if r["synced"] else " (not synced yet — run sync)"))
    out(args, res, lines)
    return 0


def cmd_pushed(args, root):
    load_job(root, args.job)
    sdir = state_dir(root)
    payload, record, nag = ((f"{args.job}.combined.json", f"{args.job}.combined-pushed.json",
                             f"{args.job}.combined.nag") if args.combined else
                            (f"{args.job}.state.json", f"{args.job}.pushed.json", f"{args.job}.nag"))
    h = args.hash
    if not h:
        state = read_json(sdir / payload) or {}
        h = state.get("content_hash")
        if not h:
            raise UsageError(f"no {'combined ' if args.combined else ''}payload for {args.job}; run sync first")
    rec = {"hash": h, "version": args.version, "pushed_at": now_iso(), "by": host_label()}
    if args.combined:
        curl = combined_url()
        if not curl:
            raise UsageError("no combined_url in the editor list; nothing to record")
        rec["url"] = curl
    write_if_changed(sdir / record, dump(rec))
    try:
        (sdir / nag).unlink()
    except FileNotFoundError:
        pass
    logger.info("recorded push of %s: version %s hash %s", args.job, args.version, h[:12])
    out(args, dict(rec, job=args.job), [f"pushed {args.job} version {args.version}"])
    return 0


def template_path() -> Path:
    return Path(os.path.realpath(__file__)).parent.parent / "templates" / "waveboard" / "page.html"


def cmd_page(args, root):
    p = template_path()
    if not p.is_file():
        raise UsageError(f"page template missing: {p}")
    out(args, {"page": str(p)}, [str(p)])
    return 0


def render_html(state: dict, bare: bool) -> str:
    tpl = template_path().read_text(encoding="utf-8")
    if SEED_MARKER not in tpl:
        raise UsageError("page template has no seed marker")
    seed = (json.dumps(state, ensure_ascii=False)
            .replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e"))
    page = tpl.replace(SEED_MARKER, f'<script type="application/json" id="seed">{seed}</script>')
    # The <title> names the published artifact in every listing, so a generic one makes
    # every board look alike. Name it after the job.
    title = html.escape(state.get("title") or state.get("job") or "", quote=False)
    if title:
        page = page.replace("<title>Wave Board</title>", f"<title>{title} · Wave Board</title>", 1)
    if bare:
        return page
    return ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
            '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
            '</head>\n<body>\n' + page + '\n</body>\n</html>\n')


def combined_seed() -> dict:
    """Every board this machine can read — registered projects — as the combined page's seed."""
    scope = team_scope()
    if not scope:
        raise UsageError(f"no team scope: add \"projects\": [<registry name or pattern>, ...] to "
                         f"{editors_path()} — the combined board is shared, so it takes only the "
                         "team's projects, never every project on this machine")
    boards = []
    seen = set()
    for name, path in registry_entries():
        if path in seen or not os.path.isdir(path) or not in_scope(name, scope):
            continue
        seen.add(path)
        proot = Path(path)
        d = proot / JOB_DIR
        if not d.is_dir():
            continue
        for jp in sorted(d.glob("*.json")):
            data, reason = board_data(proot, jp.stem)
            if data is None:
                logger.warning("combined: %s/%s skipped: %s", name, jp.stem, reason)
                continue
            data = dict(data, job=jp.stem)
            body = dict(content_of(data, dependency_view(proot, jp.stem, data)), project=name,
                        artifact_url=data.get("artifact_url"))
            boards.append(body)
    logger.info("combined: %d board(s) in the seed", len(boards))
    return {"boards": boards, "synced_at": now_iso(), "synced_by": host_label()}


def combined_template_path() -> Path:
    return template_path().parent / "combined.html"


def cmd_combined_page(args, root):
    tpl = combined_template_path().read_text(encoding="utf-8")
    if SEED_MARKER not in tpl:
        raise UsageError("combined template has no seed marker")
    seed = (json.dumps(combined_seed(), ensure_ascii=False)
            .replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e"))
    page = tpl.replace(SEED_MARKER, f'<script type="application/json" id="seed">{seed}</script>')
    if not args.bare:
        page = ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
                '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
                '</head>\n<body>\n' + page + '\n</body>\n</html>\n')
    target = Path(args.output) if args.output else Path.home() / ".cache" / "set-core" / "waveboard-combined.html"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(page, encoding="utf-8")
    curl = combined_url()
    lines = [str(target.resolve())]
    if curl:
        lines.append(f"combined board: {curl} — republish this file to it to refresh the page itself; "
                     "the data arrives through each project's push")
    else:
        lines.append("no combined_url yet: publish this file as an Artifact (capabilities {\"db\": {}}) from "
                     "the owner account, then run `set-wave-board combined-link <url>` on EVERY machine")
    if curl:
        lines += share_lines("combined", share_info(curl))
    out(args, {"file": str(target.resolve()), "combined_url": curl}, lines)
    return 0


def cmd_combined_link(args, root):
    """Record the combined board's URL in the machine-local editor list — its only write to it."""
    check_url(args.url)
    p = editors_path()
    lst, reason = load_editors()
    if lst is None:
        raise UsageError(f"{reason}; create it first as {EDITORS_SHAPE}")
    raw = json.loads(p.read_text(encoding="utf-8"))
    raw["combined_url"] = args.url
    tmp = p.with_name(p.name + ".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(dump(raw))
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)
    logger.info("combined_url recorded in the editor list")
    info = share_info(args.url)
    out(args, {"combined_url": args.url, "share": info},
        [f"combined board -> {args.url}"] + share_lines("combined", info))
    return 0


def cmd_render(args, root):
    r = sync_job(root, args.job)
    state = read_json(Path(r["payload"]))
    target = Path(args.output) if args.output else state_dir(root) / f"{args.job}.html"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(render_html(state, args.bare), encoding="utf-8")
    out(args, {"job": args.job, "file": str(target.resolve())}, [str(target.resolve())])
    return 0


# ── CLI ──────────────────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--repo", default=".", help="any path inside the repository (default: cwd)")
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("-q", "--quiet", action="store_true", help="no text output")
    common.add_argument("-v", "--verbose", action="count", default=0, help="log to stderr (-vv: debug)")

    p = argparse.ArgumentParser(prog="set-wave-board",
                                description="Live execution status of a job that runs in waves.")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", parents=[common], help="create docs/waveboard/<job>.json")
    s.add_argument("job")
    s.add_argument("--title", required=True)
    s.add_argument("--artifact-url")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("add", parents=[common], help="add an item (and its wave if new)")
    s.add_argument("job")
    s.add_argument("--wave", required=True)
    s.add_argument("--wave-title")
    s.add_argument("--item", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--evidence", help="evidence object as JSON")
    s.add_argument("--depends-on", action="append", metavar="[PROJECT:]JOB/ITEM",
                   help="an item this one waits on (repeatable)")
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("set", parents=[common], help="report an item's status (fast lane)")
    s.add_argument("job")
    s.add_argument("item")
    s.add_argument("status", choices=STATUSES)
    s.add_argument("--note")
    s.add_argument("--force", action="store_true",
                   help="set doing/done although a dependency is not done")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("link", parents=[common], help="record the published board page URL")
    s.add_argument("job")
    s.add_argument("url")
    s.set_defaults(fn=cmd_link)

    s = sub.add_parser("share", parents=[common],
                       help="the share step: who gets edit access, and from which account")
    s.add_argument("jobs", nargs="*")
    s.set_defaults(fn=cmd_share)

    for name, fn, text in (("depend", cmd_depend, "add items this item waits on"),
                           ("undepend", cmd_undepend, "remove items this item waits on")):
        s = sub.add_parser(name, parents=[common], help=text)
        s.add_argument("job")
        s.add_argument("item")
        s.add_argument("refs", nargs="+", metavar="[PROJECT:]JOB/ITEM")
        s.set_defaults(fn=fn)

    s = sub.add_parser("overview", parents=[common],
                       help="the team's boards (or --all registered projects) and their dependencies")
    s.add_argument("--all", action="store_true", help="every registered project, not only the team scope")
    s.set_defaults(fn=cmd_overview)

    s = sub.add_parser("sync", parents=[common], help="derive status from evidence, write payloads")
    s.add_argument("jobs", nargs="*")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("pushed", parents=[common], help="record that the payload was pushed")
    s.add_argument("job")
    s.add_argument("--version", type=int, required=True, help="the db document version after the write")
    s.add_argument("--hash", help="the content hash pushed (default: the current payload's)")
    s.add_argument("--combined", action="store_true",
                   help="record the push to the combined board instead of the job's own page")
    s.set_defaults(fn=cmd_pushed)

    s = sub.add_parser("pending", parents=[common], help="list jobs whose payload is not pushed")
    s.set_defaults(fn=cmd_pending)

    s = sub.add_parser("stale", parents=[common],
                       help="commits since each board last changed, and the items only an agent can move")
    s.add_argument("jobs", nargs="*")
    s.set_defaults(fn=cmd_stale)

    s = sub.add_parser("reviewed", parents=[common],
                       help="record that the items only an agent can move were checked and are current")
    s.add_argument("job")
    s.set_defaults(fn=cmd_reviewed)

    s = sub.add_parser("combined-page", parents=[common],
                       help="render the combined board page over every registered project")
    s.add_argument("-o", "--output")
    s.add_argument("--bare", action="store_true", help="no document skeleton (for publishing)")
    s.set_defaults(fn=cmd_combined_page)

    s = sub.add_parser("combined-link", parents=[common],
                       help="record the combined board URL in this machine's editor list")
    s.add_argument("url")
    s.set_defaults(fn=cmd_combined_link)

    s = sub.add_parser("page", parents=[common], help="print the page template path")
    s.set_defaults(fn=cmd_page)

    s = sub.add_parser("render", parents=[common], help="the page with the current state as seed")
    s.add_argument("job")
    s.add_argument("-o", "--output")
    s.add_argument("--bare", action="store_true",
                   help="no document skeleton (for publishing as an Artifact)")
    s.set_defaults(fn=cmd_render)
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    level = logging.WARNING - 10 * min(args.verbose, 2)
    logging.basicConfig(level=level, format="set-wave-board: %(levelname)s %(message)s",
                        stream=sys.stderr)
    try:
        root = (Path(args.repo) if args.cmd in ("page", "overview", "combined-page", "combined-link")
                else repo_root(args.repo))
        return args.fn(args, root)
    except UsageError as e:
        logger.error("%s", e)
        return 2


if __name__ == "__main__":
    sys.exit(main())
