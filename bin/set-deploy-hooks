#!/usr/bin/env bash
# set-deploy-hooks - Deploy Claude Code hooks to a target directory
#
# Usage: set-deploy-hooks [--quiet] [--no-memory] <target-dir>
#        set-deploy-hooks --auto-clear [--dry-run] [--quiet] <target-dir>
#
# --auto-clear is a SEPARATE step (auto-clear-default-install D2): it merges only the
# handoff package's reload and arm hooks, and nothing of the base set. See the block
# after _merge_hooks_additively.
#
# Deploys 2 hook events (2 entries) to <target-dir>/.claude/settings.json:
#   - PreToolUse[AskUserQuestion]: question relay, off unless this machine turns it on
#     (timeout: 3600s — it may wait for an answer from a chat channel)
#   - Stop: wave-board push reminder (timeout: 15s)
#     + wait detector (timeout: 60s; acts only while the question relay is on)
#
# It REMOVES, on every run, the skill-tracking hooks retired by `hook-diet`
# (set-hook-skill, set-hook-activity, set-hook-stop, and the old activity-track.sh path).
#
# It also REMOVES, on every run and without a flag, every `set-hook-memory` command it
# finds in any event array, plus the legacy individual memory scripts. The memory
# subsystem was removed after it was measured injecting a false "user frustrated" label
# into unrelated sessions; this is the path by which a project still carrying those hooks
# is cleaned. A project's own hooks match neither filter and survive in their order.
#
# --no-memory is accepted and does nothing: its behaviour is now the only behaviour, and
# rejecting a flag existing callers still pass would break unrelated tooling.
# Idempotent: skips if the base hooks are present and no memory hook remains.
# Before modifying an existing settings.json it backs the file up OUTSIDE the
# project tree, under ${XDG_STATE_HOME:-$HOME/.local/state}/set-core/
# settings-backup/ (see backup_settings) — never a .bak in the tree, and never
# anything on a --dry-run.

set -e

QUIET=false
NO_MEMORY=false   # accepted, unused — see the header
AUTO_CLEAR=false
DRY_RUN=false
TARGET_DIR=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --quiet|-q)
            QUIET=true
            shift
            ;;
        --no-memory)
            NO_MEMORY=true
            shift
            ;;
        --auto-clear)
            AUTO_CLEAR=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        *)
            TARGET_DIR="$1"
            shift
            ;;
    esac
done

if [[ -z "$TARGET_DIR" ]]; then
    echo "Usage: set-deploy-hooks [--quiet] [--no-memory] <target-dir>" >&2
    echo "       set-deploy-hooks --auto-clear [--dry-run] [--quiet] <target-dir>" >&2
    exit 1
fi

if $DRY_RUN && ! $AUTO_CLEAR; then
    echo "Error: --dry-run is only implemented for --auto-clear" >&2
    exit 1
fi

if [[ ! -d "$TARGET_DIR" ]]; then
    echo "Error: directory does not exist: $TARGET_DIR" >&2
    exit 1
fi

_info() { $QUIET || echo "$@"; }
_success() { $QUIET || echo "  ✔ $*"; }

settings_file="$TARGET_DIR/.claude/settings.json"

$DRY_RUN || mkdir -p "$TARGET_DIR/.claude"

# The framework's hook config. It carries NO memory hooks: the memory subsystem was
# removed after it was measured injecting a false "user frustrated" label into unrelated
# sessions (168 of 187 injections over 21 days). See openspec/changes/remove-shodh-memory.
#
# It also carries NO skill-tracking hooks any more (`hook-diet`, 2026-11-23):
# `set-hook-skill`, `set-hook-activity` and `set-hook-stop` spawned a process on every
# prompt, Skill call and Stop, and the only readers of what they wrote were the
# orchestration engine's worktree and session routes and the git-bus MCP tools — all
# being retired. The fleet reads neither file. Every deploy STRIPS them, like the memory
# hooks below.
#
# This file is also the ROOT CAUSE fix. It does not merely stop emitting those hooks —
# every deploy STRIPS any it finds, so a project cleaned by hand, restored from a backup,
# or created from an old branch converges on the next `set-project init` without anybody
# visiting it.
hook_json=$(cat << 'HOOKJSON'
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-question-relay",
            "timeout": 3600
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set-hook-waveboard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "set-hook-wait-detect",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
HOOKJSON
)

# --no-memory is accepted and does nothing. Its behaviour is now the only behaviour, and
# rejecting a flag that existing callers still pass would turn a removal into a breakage
# in unrelated tooling.
deploy_json="$hook_json"

# Additive per-event merge of set-core's hooks into an existing settings.json.
#
# WHY NOT `. * {"hooks": $hooks}`. jq's `*` merges objects recursively but REPLACES
# arrays — and every hook event IS an array. So the obvious one-liner silently
# substituted set-core's eight event arrays for the project's, discarding whatever
# else lived in them. On a measured consumer that included a PreToolUse firewall
# blocking destructive commands: removed without a word, by a tool the user ran to
# install hooks, not to remove theirs.
#
# The merge below works at two levels, because an event array holds
# `{matcher, hooks: [...]}` entries and a project routinely shares a matcher with
# set-core (one SessionStart entry carrying both a set-hook-memory command and the
# project's own script):
#
#   event array   — match the FIRST entry with the same matcher; append if none
#   inner hooks   — match by `command`; update that hook in place, else append
#
# Nothing is ever removed except by an explicit flag: $purge_legacy retires the old
# individual memory scripts, $strip_memory implements --no-memory. Both target only
# commands set-core owns; project entries survive every branch, in their order.
#
# Args: $1 settings file, $2 desired hooks object, $3 purge_legacy, $4 strip_memory
_merge_hooks_additively() {
    local file="$1" desired="$2" purge="$3" strip="$4"

    jq --argjson desired "$desired" \
       --argjson purge "$purge" \
       --argjson strip "$strip" '
        def is_legacy_cmd:
            (.command // "") | test("^set-hook-memory-(warmstart|recall|pretool|posttool|save)");
        def is_memory_cmd:
            (.command // "") | startswith("set-hook-memory");
        # Retired by hook-diet: no live reader. Stripped with the memory hooks.
        def is_retired_cmd:
            (.command // "") as $c
            | ($c == "set-hook-skill" or $c == "set-hook-activity" or $c == "set-hook-stop"
               or $c == ".claude/hooks/activity-track.sh");

        # Drop set-core-owned hooks an explicit flag asked us to retire, then drop any
        # entry left with no hooks at all. A project entry never matches either filter.
        def prune($arr):
            [ $arr[]?
              | .hooks = [ (.hooks // [])[]
                           | select(($purge and is_legacy_cmd) or ($strip and (is_memory_cmd or is_retired_cmd)) | not) ]
            ]
            | map(select(((.hooks // []) | length) > 0));

        # Merge desired hook objects into one entry.hooks array, keyed by command.
        def merge_cmds($target; $wanted):
            reduce $wanted[] as $w ($target;
                . as $cur
                | ([ range(0; $cur | length)
                     | select(($cur[.].command // "") == ($w.command // "")) ] | first) as $i
                | if $i == null then $cur + [$w] else ($cur | .[$i] = $w) end
            );

        # Merge desired entries into one event array, keyed by matcher.
        def merge_entries($target; $wanted):
            reduce $wanted[] as $w ($target;
                . as $cur
                | ([ range(0; $cur | length)
                     | select(($cur[.].matcher // "") == ($w.matcher // "")) ] | first) as $i
                | if $i == null
                  then $cur + [$w]
                  else ($cur | .[$i].hooks = merge_cmds(($cur[$i].hooks // []); ($w.hooks // [])))
                  end
            );

        .hooks = (
            reduce ($desired | to_entries[]) as $ev (
                (.hooks // {});
                .[$ev.key] = merge_entries(prune(.[$ev.key] // []); $ev.value)
            )
            # Events set-core does not ship (a project-only event) keep their entries,
            # but still honour an explicit purge/strip request. `.key` is bound first:
            # inside `$desired | has(.key)` the pipe would rebind `.` to $desired.
            | with_entries(
                . as $e
                | if ($desired | has($e.key)) then . else .value = prune($e.value) end
              )
        )
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# Back up settings.json OUTSIDE the project tree, before a merge rewrites it.
#
# The old in-tree copy ("$settings_file.bak") left an untracked file in every
# consumer's git status. The backup lives under the machine's state dir instead,
# in a directory keyed by the absolute TARGET_DIR with every / turned into -
# (leading - stripped), so trees map 1:1 to backup dirs without nesting.
#
# Printed with plain echo, NOT _info: the init report must name the backup even
# under --quiet. --dry-run never reaches a call site, so it never backs up.
backup_settings() {
    local abs key dir stamp path
    abs=$(cd "$TARGET_DIR" && pwd)
    key="${abs//\//-}"
    key="${key#-}"
    dir="${XDG_STATE_HOME:-$HOME/.local/state}/set-core/settings-backup/$key"
    mkdir -p "$dir"
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    path="$dir/settings.json.$stamp"
    cp "$settings_file" "$path"
    echo "  settings backup: $path"
}

# ── --auto-clear: the handoff package's two hooks (auto-clear-default-install D2) ──
#
# The strings are exactly what the package's `init --auto-clear` prints (stable, confirmed by
# the package on the bus 2026-11-23), so a project that merged them by hand dedups here. A
# project with its OWN mechanism keeps it: a SessionStart command containing `reinject` whose
# matcher covers the clear source, or a PostToolUse command containing `handoff-arm`, means
# the package entry is not added — two reloads after one /clear is the failure this avoids.
# These entries stay out of the base set's "already canonical" check below, so a project with
# its own reload never looks non-canonical. keep-going is opt-in and is not merged.
#
# The reload wiring stamp (`.set/handoff/.reload-wired-at`, one ISO-8601 UTC line) is written
# only when THIS step adds the reload entry — never on a no-op run, or every deploy would
# re-exclude the live sessions the watcher's start filter is meant to keep clearable.
if $AUTO_CLEAR; then
    RELOAD_CMD='node "$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-reinject-clear.mjs"'
    ARM_CMD='node "$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-arm.mjs"'
    src="$settings_file"; [[ -f "$src" ]] || src=/dev/null
    state=$(jq -n --slurpfile s <(cat "$src" 2>/dev/null || true) \
                --arg reload "$RELOAD_CMD" --arg arm "$ARM_CMD" '
        ($s[0] // {}) as $doc
        | def cmds($ev): [ ($doc.hooks[$ev] // [])[]? | . as $e | (.hooks // [])[]?
                           | {matcher: ($e.matcher // ""), command: (.command // "")} ];
        { reload_pkg: any(cmds("SessionStart")[]; .command == $reload),
          reload_own: any(cmds("SessionStart")[]; .command != $reload
                          and (.command | contains("reinject"))
                          and (.matcher == "" or (.matcher | test("(^|\\|)clear(\\||$)")))),
          arm_pkg: any(cmds("PostToolUse")[]; .command == $arm),
          arm_own: any(cmds("PostToolUse")[]; .command != $arm and (.command | contains("handoff-arm"))) }
    ') || { echo "Error: cannot read $settings_file as JSON" >&2; exit 1; }
    want_reload=false; want_arm=false
    if [[ $(jq -r .reload_pkg <<<"$state") == true ]]; then _info "  auto-clear hooks: reload already wired"
    elif [[ $(jq -r .reload_own <<<"$state") == true ]]; then
        echo "  auto-clear hooks: reload skipped — the project runs its own reinject for clear"
    else want_reload=true; fi
    if [[ $(jq -r .arm_pkg <<<"$state") == true ]]; then _info "  auto-clear hooks: arm already wired"
    elif [[ $(jq -r .arm_own <<<"$state") == true ]]; then
        echo "  auto-clear hooks: arm skipped — the project has its own handoff-arm hook"
    else want_arm=true; fi
    if ! $want_reload && ! $want_arm; then exit 0; fi
    desired=$(jq -n --arg reload "$RELOAD_CMD" --arg arm "$ARM_CMD" \
                    --argjson r "$want_reload" --argjson a "$want_arm" '
        {} + (if $r then {SessionStart: [{matcher: "clear|compact", hooks: [
                 {type: "command", command: $reload, timeout: 15}]}]} else {} end)
           + (if $a then {PostToolUse: [{matcher: "Write|Edit|MultiEdit|Bash", hooks: [
                 {type: "command", command: $arm, timeout: 10}]}]} else {} end)')
    if $DRY_RUN; then
        $want_reload && echo "  auto-clear hooks: would add reload (SessionStart clear|compact) and write .set/handoff/.reload-wired-at"
        $want_arm && echo "  auto-clear hooks: would add arm (PostToolUse Write|Edit|MultiEdit|Bash)"
        exit 0
    fi
    if [[ -f "$settings_file" ]]; then backup_settings; else echo '{}' > "$settings_file"; fi
    _merge_hooks_additively "$settings_file" "$desired" false false
    if $want_reload; then
        mkdir -p "$TARGET_DIR/.set/handoff"
        date -u +%Y-%m-%dT%H:%M:%SZ > "$TARGET_DIR/.set/handoff/.reload-wired-at"
        echo "  ✔ auto-clear hooks: reload added; wiring stamp written"
    fi
    $want_arm && echo "  ✔ auto-clear hooks: arm added"
    exit 0
fi

if [[ -f "$settings_file" ]]; then
    # Detect current hook state
    has_base=false
    has_memory=false
    has_old_activity=false

    # Base hooks present? `set-hook-waveboard` and `set-hook-question-relay` are part of
    # the base (and so is `set-hook-wait-detect`), for the same reason: without them here the early return below would call
    # a project initialised before either existed canonical, and the hook would never
    # reach it. The wave-board hook is looked for in ANY Stop entry, because the merge
    # appends it to the matcher-"" entry wherever that entry sits.
    if jq -e '.hooks.Stop[]? | .hooks[]? | select(.command == "set-hook-waveboard")' "$settings_file" &>/dev/null \
        && jq -e '.hooks.PreToolUse[]? | select(.matcher == "AskUserQuestion") | .hooks[]? | select(.command == "set-hook-question-relay")' "$settings_file" &>/dev/null \
        && jq -e '.hooks.Stop[]? | .hooks[]? | select(.command == "set-hook-wait-detect")' "$settings_file" &>/dev/null; then
        has_base=true
    fi

    # ANY memory hook, in ANY event array, with ANY matcher. There is no longer a canonical
    # memory hook, so `Read` and `Bash` are not exempt and neither are the legacy individual
    # scripts. `.value[]` yields each {matcher, hooks} entry — `.value[][]` would iterate an
    # entry's own values (a matcher string and an array), which is the bug that kept the old
    # upgrade branch from ever firing.
    mem_count=$(jq '[.hooks | to_entries[] | .value[]? | .hooks[]? |
                     select((.command // "") | startswith("set-hook-memory"))] | length' \
                "$settings_file" 2>/dev/null || echo 0)
    [[ "$mem_count" -gt 0 ]] && has_memory=true

    # Any hook retired by hook-diet, in any event array (the old activity-track.sh path
    # included — it is the same retired hook under its pre-PATH name).
    retired_count=$(jq '[.hooks | to_entries[] | .value[]? | .hooks[]? |
                         select((.command // "") as $c | $c == "set-hook-skill" or $c == "set-hook-activity"
                                or $c == "set-hook-stop" or $c == ".claude/hooks/activity-track.sh")] | length' \
                    "$settings_file" 2>/dev/null || echo 0)
    [[ "$retired_count" -gt 0 ]] && has_old_activity=true

    # Already canonical? Base hooks present, no memory hook anywhere, no retired hook.
    if $has_base && ! $has_memory && ! $has_old_activity; then
        return 0 2>/dev/null || exit 0
    fi

    # Backup before modification — outside the tree, see backup_settings
    backup_settings


    # One merge, always with BOTH removals on: the legacy individual scripts and every
    # set-hook-memory command. A project's own hooks match neither filter and survive in
    # their order.
    _merge_hooks_additively "$settings_file" "$(echo "$deploy_json" | jq '.hooks')" true true
    if $has_old_activity; then
        _success "Updated: $settings_file (removed $retired_count retired skill-tracking hook(s); project hooks preserved)"
    elif $has_memory; then
        _success "Updated: $settings_file (removed $mem_count memory hook(s); project hooks preserved)"
    else
        _success "Updated: $settings_file (hooks merged; project hooks preserved)"
    fi
else
    echo "$deploy_json" | jq '.' > "$settings_file"
    _success "Created: $settings_file (hooks)"
fi
