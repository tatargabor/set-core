#!/usr/bin/env python3
"""set-kb — project knowledge-base search: index, search, get, sources,
doctor, findability, eval. The single implementation surface (design D3):
every other tool shells out to this command.

Resolves the project from the current directory's repository root, so it
answers identically from any folder inside the project.
"""
import os
import sys

_SET_TOOLS_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_LIB = os.path.join(_SET_TOOLS_ROOT, "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from set_kb.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
